# Copy to .env.local for local work. Never commit real values.
# Production and Preview values live in Vercel → Project → Settings → Environment Variables.

# Site
PUBLIC_SITE_URL=https://shroomieshq.fan

# MusicBrainz (build time)
MUSICBRAINZ_ARTIST_MBID=
MUSICBRAINZ_USER_AGENT=ShroomiesHQ/1.0 (project-email@example.com)

# Database (Neon, Frankfurt) — use a separate branch for Preview
DATABASE_URL=

# Hashing secrets (long random strings, different per environment)
IP_HASH_SECRET=
DEVICE_HASH_SECRET=
DELETE_CODE_PEPPER=

# Admin panel
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Scheduled jobs (GitHub Actions → API)
CRON_SECRET=

# Weekly moderation digest (Resend)
RESEND_API_KEY=
MOD_EMAIL_TO=
MOD_EMAIL_FROM=
