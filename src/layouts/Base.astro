---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/primitives.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Remote from '../components/Remote.astro';
import { localePath, locales, t, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const locale = (Astro.currentLocale ?? 'en') as Locale;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} data-theme="original" data-era="halo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/init.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(path, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(path, 'en'), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={t(locale, 'journal.feed')} href={localePath('/rss.xml', locale)} />
    <link rel="preload" href="/fonts/atkinson-next-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anybody-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ededea" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'a11y.skip')}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <Remote locale={locale} />
  </body>
</html>
