---
// Component gallery for review. Not indexed; remove or protect before launch (22-milestones, M1 exit).
import Base from '../../layouts/Base.astro';

const themes = ['original', 'light', 'dark'] as const;
const eras = [
  ['halo', "HALO '25–26"],
  ['projects', "The Projects '21–23"],
  ['ltf', "LOVER TOFU FRUIT '24"],
  ['first-singles', "First singles '18–20"],
  ['covers', "Covers '15–17"],
] as const;
---

<Base title="Kit · Shroomies HQ" description="Component gallery (internal)." noindex>
  <div class="kit">
    <h1>Kit</h1>
    <p class="intro">
      Every primitive in the three themes. Turn on <b>calm</b> on the remote to check calm mode (grain and motion off);
      the remote itself is the live navigation below.
    </p>

    <div class="themes">
      {themes.map((theme) => (
        <section class="panel" data-theme={theme} aria-labelledby={`t-${theme}`}>
          <h2 id={`t-${theme}`}>{theme}</h2>

          <h3>Type</h3>
          <p class="display">Display 900</p>
          <p>Body text in Atkinson Hyperlegible Next with a <a href="#t-original">link</a> and <span class="muted">muted text</span>.</p>
          <p class="hand">a note for Tiff ✿</p>

          <h3>Buttons</h3>
          <div class="row">
            <button type="button" class="btn btn-primary">Primary</button>
            <button type="button" class="btn btn-secondary">Secondary</button>
            <button type="button" class="btn btn-hot">Hot</button>
            <button type="button" class="btn btn-secondary btn-sm">Small</button>
          </div>

          <h3>LCD chip</h3>
          <p><span class="lcd">TRK 02 · THE SHELF</span></p>

          <h3>Flyer, tape, pin</h3>
          <div class="row flyers">
            <div class="flyer"><span class="tape"></span>Flyer with tape</div>
            <div class="flyer tilt-right"><span class="pin"></span>Flyer with a pin</div>
          </div>

          <h3>Surfaces</h3>
          <div class="surfaces">
            <p class="band">Band</p>
            <p class="inverse">Inverse panel <span>muted</span></p>
            <p class="cork">Cork</p>
          </div>

          <h3>Era accents</h3>
          <ul class="eras">
            {eras.map(([id, name]) => (
              <li data-era={id} data-theme={theme}><span class="fill">{name}</span> <span class="era-text">{name}</span></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .kit { width: var(--column); margin-inline: auto; display: grid; gap: 1.5rem; }
  .intro { max-width: 70ch; color: var(--muted); }
  .themes { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .panel {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.25rem;
    background: var(--bg);
    color: var(--ink);
    border: var(--border) solid var(--line);
  }
  .panel h2 { text-transform: capitalize; }
  .panel h3 { margin-top: 0.75rem; font-size: 1rem; font-stretch: 130%; }
  .panel a { color: var(--link); }
  .display { font: 900 1.75rem/1 var(--font-display); font-stretch: 120%; }
  .muted { color: var(--muted); }
  .hand { font: 1.375rem var(--font-hand); }
  .row { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .flyers { gap: 1.5rem; padding-top: 0.75rem; }
  .tilt-right { --tilt: 2deg; }
  .surfaces { display: grid; gap: 0.5rem; }
  .surfaces p { padding: 0.5rem 0.75rem; }
  .band { background: var(--band); color: var(--band-ink); }
  .inverse { background: var(--inverse); color: var(--inverse-ink); }
  .inverse span { color: var(--inverse-muted); }
  .cork { background: var(--cork); color: var(--cork-ink); }
  .eras { display: grid; gap: 0.375rem; margin: 0; padding: 0; list-style: none; font-size: var(--fs-small); }
  .fill { display: inline-block; padding: 0.125rem 0.5rem; background: var(--era-accent); color: var(--on-era-accent); font-weight: 700; }
  .era-text { color: var(--era-accent-text); font-weight: 700; }
</style>
