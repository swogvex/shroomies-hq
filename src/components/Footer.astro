---
import { getEntry } from 'astro:content';
import { localePath, t, type Locale } from '../i18n';
import { finePrint } from '../lib/sections';

const { locale } = Astro.props as { locale: Locale };
const { official } = (await getEntry('site', 'site'))!.data;
// her official channels first (they open her pages), then the fine print; our X joins when the project has one
const external = [
  [official.site.url, 'footer.official'],
  [official.spotify.url, 'footer.spotify'],
] as const;
---

<footer class="site-footer">
  <div class="about">
    <img src="/brand/badge.svg" width="64" height="64" alt="" />
    <p><b>{t(locale, 'footer.made')}</b> {t(locale, 'footer.disclaimer')}</p>
  </div>
  <nav aria-label={t(locale, 'footer.nav')}>
    <!-- two rows that wrap on their own: her official pages, then the fine print -->
    <p class="group">{external.map(([href, key]) => href && <a href={href} rel="noopener">{t(locale, key)} <span aria-hidden="true">↗</span></a>)}</p>
    <p class="group">{finePrint.map((slug) => <a href={localePath(`/${slug}/`, locale)}>{t(locale, `fine.${slug}`)}</a>)}</p>
  </nav>
</footer>

<style>
  .site-footer {
    width: var(--column);
    margin: 4rem auto 0;
    padding-block: 1.125rem 2rem;
    border-top: var(--border-strong) solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
    font-size: var(--fs-small);
  }
  .about { display: flex; gap: 0.875rem; align-items: flex-start; }
  .about img { flex: none; }
  .about p { max-width: 60ch; }
  nav { display: grid; align-content: start; gap: 0.25rem; min-width: 0; }
  .group { display: flex; flex-wrap: wrap; gap: 0 1.125rem; justify-content: flex-end; }
  /* phones: one column, so the links read as a left-aligned list */
  @media (max-width: 40rem) { .group { justify-content: flex-start; } }
  nav a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
