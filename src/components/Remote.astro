---
// The remote: main navigation, built on the owner's dock (docs/ai/reference/dock/). The seven links are a real
// <nav> list; without JS (and in print) only that list shows, as a plain dock. JS adds the skin around it.
import { localePath, t, type Locale } from '../i18n';
import { neighbours, sectionIndex, sections } from '../lib/sections';

const { locale } = Astro.props as { locale: Locale };
const bare = localePath(Astro.url.pathname, 'en');
const current = sectionIndex(bare);
const { prev, next } = neighbours(current);
const shown = sections[Math.max(current, 0)]!;
const track = `${t(locale, 'remote.trk')} ${shown.n} · ${shown.lcd}`;
const href = (i: number) => localePath(sections[i]!.path, locale);
---

<section class="remote" aria-label={t(locale, 'remote.label')} data-remote data-calm-on={t(locale, 'remote.calmOn')} data-calm-off={t(locale, 'remote.calmOff')}
  data-mode={t(locale, 'remote.mode')}>
  <a class="rk rk-step skin" href={href(prev)} data-step="prev">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M19 5 9 12l10 7z" /></svg>
    <span aria-hidden="true">{t(locale, 'remote.prevKey')}</span>
    <span class="visually-hidden">{t(locale, 'remote.prev')}</span>
  </a>

  <div class="remote-lcd lcd-desk skin" aria-hidden="true">
    <span class="lcd-top"><span data-lcd-mode>▶ {t(locale, 'remote.mode')}</span><span class="clock"><span data-clock>--:--</span><span class="bars"></span></span></span>
    <span class="lcd-track" lang="en">{track}</span>
  </div>
  <button type="button" class="remote-lcd lcd-mob skin" aria-expanded="false" aria-controls="tracklist" data-tracklist-toggle>
    <span class="lcd-top" aria-hidden="true"><span data-lcd-mode>SHROOMIES FM</span><span>▲ {t(locale, 'remote.list')}</span></span>
    <span class="lcd-track" aria-hidden="true" lang="en">{shown.n} {shown.lcd}</span>
    <span class="visually-hidden">{t(locale, 'remote.tracklist')}</span>
  </button>

  <a class="rk rk-step skin" href={href(next)} data-step="next">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M5 5l10 7-10 7z" /></svg>
    <span aria-hidden="true">{t(locale, 'remote.nextKey')}</span>
    <span class="visually-hidden">{t(locale, 'remote.next')}</span>
  </a>

  <span class="sep skin" aria-hidden="true"></span>

  <div class="tracklist" id="tracklist" data-tracklist>
    <p class="tracklist-title skin" aria-hidden="true">{t(locale, 'remote.tracklistTitle')}</p>
    <nav aria-label={t(locale, 'nav.main')}>
      <ul>
        {sections.map((s, i) => (
          <li>
            <a class="rk" href={href(i)} aria-current={i === current ? 'page' : undefined} data-track={i + 1}>
              <b>{s.n}</b>
              <span class="lcd-name" aria-hidden="true" lang="en">{s.lcd}</span>
              <span class="key-label">{t(locale, s.label)}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="calm skin">
      <button type="button" class="sw" role="switch" aria-checked="false" data-calm-switch>
        <span class="knob" aria-hidden="true"></span>
        <span class="visually-hidden">{t(locale, 'remote.calm')}</span>
      </button>
      <span class="calm-label" aria-hidden="true">{t(locale, 'remote.calmKey')}</span>
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-remote-say></p>
</section>

<script>
  const root = document.documentElement;
  const remote = document.querySelector<HTMLElement>('[data-remote]');

  if (remote) {
    const say = remote.querySelector<HTMLElement>('[data-remote-say]')!;
    const toggle = remote.querySelector<HTMLButtonElement>('[data-tracklist-toggle]')!;
    const calm = remote.querySelector<HTMLButtonElement>('[data-calm-switch]')!;
    const { calmOn, calmOff, mode } = remote.dataset as Record<string, string>;

    // Calm mode: the switch, the LCD line and the stored choice stay in sync.
    const paintCalm = () => {
      const on = root.hasAttribute('data-calm');
      calm.setAttribute('aria-checked', String(on));
      for (const el of remote.querySelectorAll('[data-lcd-mode]')) {
        el.textContent = on ? calmOn! : el.closest('.lcd-desk') ? `▶ ${mode}` : 'SHROOMIES FM';
      }
    };
    calm.addEventListener('click', () => {
      const on = !root.hasAttribute('data-calm');
      root.toggleAttribute('data-calm', on);
      try {
        localStorage.setItem('shq:calm', on ? 'on' : 'off');
      } catch {
        // storage blocked: calm still applies to this page
      }
      paintCalm();
      say.textContent = on ? calmOn! : calmOff!;
    });
    paintCalm();

    // Phone: the display opens the tracklist like the back of a CD case.
    const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('click', (e) => {
      if (!remote.contains(e.target as Node)) setOpen(false);
    });
    remote.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
      // ← → walk the tracklist while focus is on the remote
      if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') && !e.altKey && !e.ctrlKey && !e.metaKey) {
        const step = remote.querySelector<HTMLAnchorElement>(`[data-step="${e.key === 'ArrowLeft' ? 'prev' : 'next'}"]`);
        if (step) location.href = step.href;
      }
    });

    // 1–7 jump to a track, unless the visitor is typing.
    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.repeat || !/^[1-7]$/.test(e.key)) return;
      const t = e.target as HTMLElement;
      if (t.isContentEditable || t.closest('input, textarea, select, [role="textbox"]')) return;
      const link = remote.querySelector<HTMLAnchorElement>(`[data-track="${e.key}"]`);
      if (link) location.href = link.href;
    });

    // Local clock on the LCD (decorative, hidden from screen readers).
    const clock = remote.querySelector<HTMLElement>('[data-clock]')!;
    const tick = () => {
      const d = new Date();
      clock.textContent = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    };
    tick();
    setInterval(tick, 15_000);

    // Phones: hide the remote while the on-screen keyboard is open so it never floats over a form.
    const vv = window.visualViewport;
    vv?.addEventListener('resize', () => remote.toggleAttribute('data-keyboard', vv.height < window.innerHeight * 0.75));
  }
</script>

<style>
  /* ---------- plain dock: no JS, print, reader mode ---------- */
  .remote {
    position: fixed;
    z-index: 50;
    inset-inline: 0;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    width: max-content;
    max-width: calc(100% - 1rem);
    margin-inline: auto;
    padding: 0.5rem;
    background: var(--c-remote-lo);
    color: var(--c-flash);
    border: 1px solid var(--c-remote-edge);
    box-shadow: 6px 6px 0 var(--c-strobe);
  }
  .skin { display: none; }
  .remote[data-keyboard] { display: none !important; }
  ul { display: flex; gap: 0.25rem; margin: 0; padding: 0; list-style: none; overflow-x: auto; }
  nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 3.25rem;
    min-height: 44px;
    padding: 0.25rem 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.1;
    color: var(--c-flash);
    text-decoration: none;
  }
  .rk { text-decoration: none; }
  li { flex: 1 1 0; }
  @media (max-width: 30rem) {
    nav a { min-width: 0; padding-inline: 0.125rem; font-size: 0.6875rem; }
  }
  nav a[aria-current='page'] { background: var(--c-flash); color: var(--c-ink); font-weight: 700; }
  nav b { font: 400 1.25rem/0.9 var(--font-lcd); }
  .lcd-name { display: none; }
  .remote :focus-visible { outline: var(--focus); outline-offset: 3px; }

  @media print {
    .remote { position: static; box-shadow: none; border: 0; background: none; color: inherit; }
    nav a { color: inherit; }
  }

  /* ---------- the skin (JS on, screen) ---------- */
  @media screen {
    :global(html[data-js]) .remote {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-remote);
      background: linear-gradient(180deg, var(--c-remote-hi) 0%, var(--c-remote-mid) 45%, var(--c-remote-lo) 100%);
      border: 1px solid var(--c-remote-edge);
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, var(--c-flash) 14%, transparent),
        0 4px 0 var(--c-remote-edge),
        0 24px 40px -16px color-mix(in srgb, var(--c-ink) 70%, transparent);
    }
    :global(html[data-js]) .skin { display: revert; }
    :global(html[data-js]) .rk-step, :global(html[data-js]) .remote-lcd { display: flex; }
    :global(html[data-js]) .calm { display: flex; }
    :global(html[data-js]) .tracklist { display: contents; }
    :global(html[data-js]) .tracklist-title { display: none; }

    :global(html[data-js]) .remote .rk {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      line-height: 1;
      text-align: center;
      min-width: 3.625rem;
      height: 52px;
      padding: 0 0.375rem;
      border-radius: var(--radius-key);
      background: linear-gradient(var(--c-key-hi), var(--c-key-lo));
      color: var(--c-flash);
      font-size: 0.75rem;
      font-weight: 700;
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, var(--c-flash) 22%, transparent),
        inset 0 -4px 0 color-mix(in srgb, var(--c-ink) 45%, transparent),
        0 3px 0 var(--c-remote-edge);
      transition: transform 80ms;
    }
    :global(html[data-js]) .remote .rk:hover { transform: translateY(-2px); }
    :global(html[data-js]) .remote .rk:active { transform: translateY(2px); box-shadow: inset 0 3px 6px color-mix(in srgb, var(--c-ink) 65%, transparent), 0 1px 0 var(--c-remote-edge); }
    :global(html[data-js]) .remote .rk[aria-current='page'] {
      background: linear-gradient(var(--c-flash), var(--c-key-on-lo));
      color: var(--c-ink);
      box-shadow: inset 0 -4px 0 color-mix(in srgb, var(--c-ink) 16%, transparent), 0 3px 0 var(--c-remote-edge), 0 0 18px color-mix(in srgb, var(--c-lcd-1) 45%, transparent);
    }
    .rk-step svg { width: 18px; height: 18px; fill: currentColor; stroke: currentColor; stroke-width: 2; }
    :global(html[data-js]) nav ul { gap: 0.375rem; overflow: visible; }
    :global(html[data-js]) .remote nav .rk { width: 4.75rem; }

    .remote-lcd {
      flex-direction: column;
      justify-content: center;
      gap: 0.25rem;
      width: 17.5rem;
      overflow: hidden;
      height: 60px;
      padding: 0.375rem 0.75rem;
      border: 0;
      border-radius: 10px;
      text-align: start;
      background: linear-gradient(180deg, var(--c-lcd-1), var(--c-lcd-2));
      box-shadow: inset 0 3px 8px color-mix(in srgb, var(--c-ink) 50%, transparent), inset 0 0 0 2px color-mix(in srgb, var(--c-ink) 25%, transparent);
      color: var(--c-lcd-ink);
      font-family: var(--font-lcd);
      white-space: nowrap;
    }
    .lcd-top { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.875rem; line-height: 1; }
    .lcd-track { font-size: 1.375rem; line-height: 0.9; overflow: hidden; text-overflow: ellipsis; }
    /* the mode text gives way first, so the clock and bars are never clipped in any language */
    .lcd-top > :first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .clock { display: flex; flex: none; align-items: center; gap: 0.375rem; }
    /* signal bars drawn in CSS: the ▮ glyph isn't in the LCD font and the fallback is too wide */
    .bars { width: 1.125rem; height: 0.5rem; background: repeating-linear-gradient(90deg, currentColor 0 4px, transparent 4px 7px); }
    .sep { width: 2px; height: 52px; margin-inline: 0.125rem; background: linear-gradient(var(--c-remote-edge), var(--c-remote-line)); }

    .calm { flex-direction: column; align-items: center; gap: 0.25rem; }
    .sw {
      position: relative;
      width: 52px;
      height: 28px;
      padding: 0;
      border: 0;
      border-radius: 14px;
      background: var(--c-remote-edge);
      box-shadow: inset 0 2px 5px color-mix(in srgb, var(--c-ink) 80%, transparent), 0 1px 0 color-mix(in srgb, var(--c-flash) 12%, transparent);
      cursor: pointer;
    }
    /* 44 px hit area around the 28 px switch */
    .sw::before { content: ''; position: absolute; inset: -8px -4px; }
    .knob {
      position: absolute;
      top: 3px;
      left: 3px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: linear-gradient(var(--c-flash), var(--c-key-on-lo));
      box-shadow: 0 2px 3px color-mix(in srgb, var(--c-ink) 60%, transparent);
      transition: translate 120ms;
    }
    .sw[aria-checked='true'] { background: var(--c-lcd-2); }
    .sw[aria-checked='true'] .knob { translate: 24px 0; }
    .calm-label { font-size: 0.6875rem; color: var(--c-remote-label); }

    /* desktop keeps the LCD as a display; the phone turns it into the tracklist button */
    :global(html[data-js]) .lcd-mob { display: none; }

    @media (max-width: 71.99rem) {
      :global(html[data-js]) .remote { width: auto; inset-inline: 0.5rem; max-width: 30rem; gap: 0.375rem; padding: 0.5rem; }
      :global(html[data-js]) .lcd-desk, :global(html[data-js]) .sep { display: none; }
      :global(html[data-js]) .lcd-mob { display: flex; flex: 1; width: auto; height: 52px; cursor: pointer; }
      :global(html[data-js]) .rk-step { min-width: 3rem; }

      /* the tracklist sheet slides up above the bar */
      :global(html[data-js]) .tracklist {
        display: none;
        position: absolute;
        inset-inline: 0;
        bottom: calc(100% + 0.5rem);
        max-height: min(70dvh, 34rem);
        overflow-y: auto;
        padding: 1rem;
        border-radius: 1.25rem;
        border-top: 3px solid var(--c-lcd-1);
        background: var(--c-remote-lo);
        box-shadow: 0 -12px 30px -12px color-mix(in srgb, var(--c-ink) 60%, transparent);
      }
      :global(html[data-js]) .remote:has([aria-expanded='true']) .tracklist { display: block; }
      :global(html[data-js]) .tracklist-title { display: block; }
      .tracklist-title { margin-bottom: 0.25rem; font: 400 1.25rem var(--font-lcd); color: var(--c-lcd-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      :global(html[data-js]) nav ul { flex-direction: column; gap: 0; }
      :global(html[data-js]) .remote nav .rk {
        flex-direction: row;
        align-items: baseline;
        justify-content: flex-start;
        text-align: start;
        gap: 0.75rem;
        width: 100%;
        height: auto;
        min-height: 52px;
        padding: 0.75rem 0.25rem;
        border-radius: 0;
        background: none;
        box-shadow: none;
        border-bottom: 1px dashed var(--c-remote-line);
      }
      :global(html[data-js]) .remote nav .rk[aria-current='page'] { background: color-mix(in srgb, var(--c-lcd-1) 12%, transparent); color: var(--c-flash); box-shadow: none; }
      :global(html[data-js]) .remote nav .rk b { width: 1.75rem; color: var(--c-lcd-1); font-size: 1.5rem; }
      :global(html[data-js]) .lcd-name { display: block; flex: 1; font: 800 1.0625rem var(--font-display); font-stretch: 120%; }
      :global(html[data-js]) .remote nav .key-label { font-size: 0.75rem; font-weight: 400; color: var(--c-remote-label); }
      :global(html[data-js]) .calm { flex-direction: row; gap: 0.75rem; margin-top: 0.75rem; }
      .calm-label { font-size: 0.875rem; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remote .rk, .knob { transition: none; }
  }
  :global(html[data-calm]) .remote .rk:hover { transform: none; }
</style>
