---
// Player gate (08-spec-music): nothing from Spotify loads until the visitor presses the button, on every page view.
// Without JS the button stays hidden and the plain "Open it on Spotify" link does the job.
import { t, type Locale } from '../i18n';
import { spotifyEmbed, type Links } from '../lib/musicbrainz';

interface Props {
  locale: Locale;
  title: string;
  links: Links;
  /** Artist page, shown when this release has no Spotify link yet. */
  artistSpotify?: string | null;
  /** Inside a card (home song of the day): no frame or title, "Listen on Spotify", the privacy note under the button. */
  inline?: boolean;
}

const { locale, title, links, artistSpotify, inline = false } = Astro.props;
const spotify = links.spotify;
const embed = spotify && spotifyEmbed(spotify);
const others = (
  [
    ['apple', 'Apple Music'],
    ['youtube', 'YouTube'],
    ['bandcamp', 'Bandcamp'],
  ] as const
).filter(([key]) => links[key]);
---

<div class:list={['gate', { inline }]} data-gate={embed} data-frame-title={t(locale, 'player.frame', { title })} data-tall={spotify?.includes('/album/') ? '' : undefined}>
  {!inline && <span class="tape" aria-hidden="true"></span>}
  {!inline && <p class="gate-title">{t(locale, 'player.listen')}</p>}
  {
    spotify ? (
      <>
        {!inline && <p class="gate-note">{t(locale, 'player.note')}</p>}
        <div class="gate-row">
          <button type="button" class="btn btn-primary" hidden data-gate-load>
            <span aria-hidden="true">▶</span> {t(locale, inline ? 'player.listenOn' : 'player.load')}
          </button>
          <slot name="beside" />
        </div>
        <div class="gate-frame" data-gate-frame></div>
        <p class="gate-fallback" data-gate-fallback>
          <span class="gate-failed" hidden data-gate-failed>{t(locale, 'player.failed')} </span>
          <a href={spotify} rel="noopener">{t(locale, 'player.open')} ↗</a>
        </p>
        {inline && <p class="gate-note gate-small">{t(locale, 'player.inlineNote')}</p>}
      </>
    ) : (
      <slot name="beside" />
      <p class="gate-note">
        {t(locale, 'player.none')}
        {artistSpotify && <a href={artistSpotify} rel="noopener">{t(locale, 'player.artist')} ↗</a>}
      </p>
    )
  }
  {
    !inline && others.length > 0 && (
      <p class="gate-also">
        {t(locale, 'player.alsoOn')}{' '}
        {others.map(([key, name], i) => (
          <>
            {i > 0 && ' · '}
            <a href={links[key]} rel="noopener">{name} ↗</a>
          </>
        ))}
      </p>
    )
  }
</div>

<script>
  for (const gate of document.querySelectorAll<HTMLElement>('[data-gate]')) {
    const load = gate.querySelector<HTMLButtonElement>('[data-gate-load]');
    const fallback = gate.querySelector<HTMLElement>('[data-gate-fallback]')!;
    if (!load) continue;
    load.hidden = false;
    fallback.hidden = true;
    const failed = gate.querySelector<HTMLElement>('[data-gate-failed]')!;
    const box = gate.querySelector<HTMLElement>('[data-gate-frame]')!;
    let timer = 0;
    // a page that changes the song in place (the aura reading) re-arms the gate: data-gate holds the new embed
    gate.addEventListener('gate:reset', () => {
      clearTimeout(timer);
      box.replaceChildren();
      load.hidden = false;
      fallback.hidden = true;
      failed.hidden = true;
    });
    load.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = gate.dataset.gate!;
      frame.title = gate.dataset.frameTitle!;
      frame.loading = 'lazy';
      frame.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      frame.height = 'tall' in gate.dataset ? '352' : '152';
      // A blocked or offline embed never fires load: after a while, say so and offer the link.
      timer = window.setTimeout(() => {
        fallback.hidden = false;
        failed.hidden = false;
      }, 10_000);
      frame.addEventListener('load', () => clearTimeout(timer), { once: true });
      box.append(frame);
      load.hidden = true;
      frame.focus();
    });
  }
</script>

<style>
  .gate {
    position: relative;
    display: grid;
    gap: 0.625rem;
    padding: 1.125rem;
    background: var(--surface);
    border: var(--border) solid var(--line);
  }
  .gate.inline { padding: 0; background: none; border: 0; justify-items: start; }
  .gate.inline .gate-frame:not(:empty) { justify-self: stretch; }
  .gate-row { display: flex; flex-wrap: wrap; gap: 0.875rem; align-items: center; }
  .gate-row:not(:has(> :not([hidden]))) { display: none; }
  .gate:not(.inline) .gate-row > .btn { flex: 1; }
  .gate-small { font-size: var(--fs-small); color: var(--muted); }
  .gate-title { font-weight: 700; }
  .gate-note, .gate-fallback, .gate-also { font-size: 0.875rem; }
  .gate-note a { display: block; margin-top: 0.25rem; }
  .gate-frame:empty { display: none; }
  .gate-frame :global(iframe) { display: block; width: 100%; border: 0; border-radius: 12px; }
</style>
