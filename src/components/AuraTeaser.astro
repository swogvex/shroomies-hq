---
// The small flyer that sends to B1 · the aura reading (25-spec, "Teasers"): Home and Music. A mini polaroid with the
// four auras mixing, the question and the call. No script: the whole card is one link.
import { localePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: cls } = Astro.props;
---

<a class:list={['aura-teaser', 'lift', cls]} href={localePath('/aura/', locale)}>
  <span class="mini" aria-hidden="true">
    <span class="b b1"></span><span class="b b2"></span><span class="b b3"></span><span class="b b4"></span>
    <img src="/stickers/halo-shroom.svg" alt="" width="248" height="248" loading="lazy" decoding="async" />
  </span>
  <span class="words">
    <span class="kicker-line">{t(locale, 'aura.teaserKicker')}</span>
    <span class="q">{t(locale, 'aura.teaser')}</span>
    <span class="cta">{t(locale, 'aura.teaserCta')} <span aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  .aura-teaser {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 1rem 0.625rem 0.625rem;
    background: var(--surface);
    color: var(--ink);
    border: var(--border) solid var(--line);
    text-decoration: none;
    rotate: -1.5deg;
  }
  .mini {
    position: relative;
    width: 4.25rem;
    aspect-ratio: 1;
    overflow: hidden;
    isolation: isolate;
    background: #14163a;
    border: var(--border) solid var(--c-ink);
    outline: 0.25rem solid #fbfaf6;
    outline-offset: 0;
    box-shadow: 0 0 0 calc(0.25rem + 2px) var(--c-ink);
    margin: 0.375rem;
    rotate: 4deg;
  }
  .b { position: absolute; width: 70%; aspect-ratio: 1; border-radius: 50%; filter: blur(8px); mix-blend-mode: screen; }
  .b1 { left: -20%; top: -20%; background: #9aa6ff; }
  .b2 { right: -25%; top: 10%; background: #ff4a1c; }
  .b3 { left: 0; bottom: -30%; background: #3f9a3a; }
  .b4 { right: -10%; bottom: -25%; background: #2335f0; }
  .mini img { position: absolute; inset: 14%; z-index: 1; width: 72%; height: auto; }
  .words { display: grid; gap: 0.125rem; min-width: 0; }
  .kicker-line { font: 1rem/1 var(--font-lcd); color: var(--muted); text-transform: uppercase; }
  .q { font: 900 1.25rem/1.05 var(--font-display); font-stretch: 125%; overflow-wrap: break-word; }
  .cta { font-size: 0.875rem; font-weight: 700; text-decoration: underline; text-underline-offset: 0.15em; }
  .aura-teaser:hover .b { scale: 1.2; }
  .b { transition: scale 300ms; }
  :global(html[data-calm]) .b { transition: none; }
</style>
