---
import Wordmark from './Wordmark.astro';
import { localePath, t, type Locale } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const other: Locale = locale === 'en' ? 'es' : 'en';
const themes = {
  original: t(locale, 'theme.original'),
  light: t(locale, 'theme.light'),
  dark: t(locale, 'theme.dark'),
};
---

<header class="site-header">
  <a class="home" href={localePath('/', locale)}>
    <img src="/brand/badge.svg" width="46" height="46" alt="" />
    <Wordmark />
    <span class="visually-hidden">{t(locale, 'header.home')}</span>
  </a>
  <div class="tools">
    <span class="tagline">{t(locale, 'site.tagline')}</span>
    <!-- needs JS to work, so it stays hidden until the script runs -->
    <button type="button" class="btn btn-secondary btn-sm theme-pill" hidden
      data-names={JSON.stringify(themes)} data-label={t(locale, 'theme.change')}>◐ <span></span></button>
    <a class="btn btn-secondary btn-sm" href={localePath(Astro.url.pathname, other)} hreflang={other} lang={other}><span aria-hidden="true">{other.toUpperCase()}</span><span class="visually-hidden">{t(locale, 'lang.switch')}</span></a>
  </div>
</header>

<script>
  const order = ['original', 'light', 'dark'] as const;
  type Theme = (typeof order)[number];
  const root = document.documentElement;
  for (const pill of document.querySelectorAll<HTMLButtonElement>('.theme-pill')) {
    const names = JSON.parse(pill.dataset.names!) as Record<Theme, string>;
    const paint = () => {
      const name = names[(root.dataset.theme as Theme) ?? 'original'];
      pill.querySelector('span')!.textContent = name;
      pill.setAttribute('aria-label', pill.dataset.label!.replace('{name}', name));
    };
    pill.addEventListener('click', () => {
      const next = order[(order.indexOf(root.dataset.theme as Theme) + 1) % order.length]!;
      root.dataset.theme = next;
      try {
        localStorage.setItem('shq:theme', next);
      } catch {
        // storage blocked (private mode): the theme still changes, it just isn't remembered
      }
      paint();
    });
    paint();
    pill.hidden = false;
  }
</script>

<style>
  .site-header {
    width: var(--column);
    margin-inline: auto;
    padding-block: 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }
  .home { display: flex; align-items: center; gap: 0.625rem; min-width: 0; color: var(--ink); }
  .home img { flex: none; }
  .tools { display: flex; flex: none; gap: 0.5rem; align-items: center; }
  .tagline { font-size: var(--fs-small); color: var(--muted); margin-inline-end: 0.375rem; }
  /* phones: logo and buttons stay on one row instead of leaving a half-empty second line */
  @media (max-width: 48rem) {
    .tagline { display: none; }
    .home { gap: 0.5rem; }
    .home img { width: 36px; height: 36px; }
    .home :global(.wordmark) { height: 26px; }
  }
  @media (max-width: 23rem) {
    .home img { display: none; }
  }
</style>
