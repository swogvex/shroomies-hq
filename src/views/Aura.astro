---
// B1 · The aura reading (25-spec-aura-reading, board B2-Aura adapted). Intro → 8 questions → result, all in the browser.
// The 8 questions and the deck are built here; the scoring is src/lib/aura.ts. Without JS: the intro and the full deck.
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PlayerGate from '../components/PlayerGate.astro';
import { localePath, t, type Locale } from '../i18n';
import { auraEras } from '../lib/aura';
import { auraReading, titleFit } from '../lib/music';
import { spotifyEmbed } from '../lib/musicbrainz';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const aura = await auraReading();
const site = (await getEntry('site', 'site'))!.data;
const L = (b: { en: string; es: string }) => b[locale];
const eraData = new Map((await getCollection('eras')).map((e) => [e.id, e.data]));
const eras = auraEras.map((id) => ({ id, name: eraData.get(id)!.title, years: eraData.get(id)!.years, tag: L(aura.eras[id].tag), line: L(aura.eras[id].line) }));
const keys = ['A', 'B', 'C', 'D'];
const pad = (n: number) => String(n).padStart(2, '0');

// art drawn on the cards: the series 01 stickers (scene and sticker questions)
const sceneArt = ['plushie-backpack', 'over-ears', 'ict-lax', 'nail-salon-rave'];
const stickerArt = ['echo-well', 'mix-for-tiff', 'bunny-fruit', 'flash'];

// the deck, grouped for the "every possible result" list
const byEra = eras.map((e) => {
  const songs = aura.deck.filter((s) => s.era === e.id && !s.standalone);
  const releases = [...new Set(songs.map((s) => s.releaseTitle))].map((title) => ({ title, songs: songs.filter((s) => s.releaseTitle === title) }));
  return { ...e, count: songs.length, releases };
});
const solo = aura.deck.filter((s) => s.standalone);

// compact data for the script (the deck is inlined at build: no request, no framework)
const data = {
  feelings: aura.feelings.map((f) => ({ id: f.id, why: L(f.why) })),
  eras: eras.map(({ id, name, years, tag, line }) => ({ id, name, years, tag, line, fit: titleFit(name) })),
  questions: aura.questions.map((q) => ({ kicker: L(q.kicker), options: q.options.map((o) => ({ era: o.era, feelings: o.feelings })) })),
  deck: aura.deck.map((s) => ({ ...s, fit: titleFit(s.title), embed: s.spotify && spotifyEmbed(s.spotify), href: localePath(`/music/${s.release}/`, locale) })),
  s: Object.fromEntries(
    (['from', 'soloFrom', 'because', 'copyText', 'copyTextSolo', 'stamp', 'announce', 'announceSolo', 'copied', 'copyFailed', 'progress', 'next', 'finish', 'myAura', 'mySong', 'fanLine', 'cardAlt', 'whiteLight', 'last'] as const).map((k) => [k, t(locale, `aura.${k}`)]),
  ),
  locale,
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<Base title={t(locale, 'aura.title')} description={t(locale, 'aura.description')}>
  <div class="aura" data-aura>
    <script type="application/json" data-aura-data set:html={json} />
    <!-- one h1 for every stage (intro, questions, result); the intro's huge title is its visual twin -->
    <h1 id="aura-title" class="visually-hidden">{t(locale, 'aura.h1')}</h1>

    <!-- ============ intro ============ -->
    <section class="intro" data-stage="intro" aria-labelledby="aura-title">
      <div class="intro-copy">
        <p class="lcd chip">{t(locale, 'aura.chip')}</p>
        <p class="title" aria-hidden="true">{t(locale, 'aura.h1')}</p>
        <p class="lead" set:html={t(locale, 'aura.lead')} />
        <p class="note">{t(locale, 'aura.note')}</p>
        <div class="cta">
          <button type="button" class="btn btn-primary btn-big" data-start hidden><span aria-hidden="true">▶</span> {t(locale, 'aura.start')}</button>
          <a class="see-all" href="#deck">{t(locale, 'aura.seeAll')}</a>
        </div>
        <p class="meta">{t(locale, 'aura.meta')}</p>
        <p class="nojs" data-nojs>{t(locale, 'aura.noJs')}</p>
        <p class="last" data-last hidden><span class="lcd">{t(locale, 'aura.last')}</span> <a href="#" data-last-link></a></p>
      </div>

      <figure class="polaroid hero" aria-hidden="true">
        <span class="tape"></span>
        <div class="photo" data-aura-skin="all">
          <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span><span class="blob b4"></span>
          <img class="shroom" src="/stickers/halo-shroom.svg" alt="" width="248" height="248" />
        </div>
        <figcaption class="hand">{t(locale, 'aura.goesHere')}</figcaption>
        <img class="sticker-start" src="/stickers/start-over.svg" alt="" width="120" height="120" loading="lazy" />
      </figure>
      <p class="hand develops" aria-hidden="true">{t(locale, 'aura.develops')} <span>↘</span></p>

      <div class="auras">
        <p class="auras-label">{t(locale, 'aura.fourAuras')}</p>
        <ul>
          {eras.map((e) => (
            <li class="aura-chip"><span class="swatch" data-aura-skin={e.id}></span><b>{e.name}</b> <span class="yrs">{e.years}</span></li>
          ))}
          <li class="aura-chip solo"><span class="swatch" data-aura-skin="solo"></span><b>{t(locale, 'aura.soloDeck')}</b> <span class="yrs">{t(locale, 'aura.justSong')}</span></li>
        </ul>
      </div>

      <div class="strip">
        <p class="strip-title"><b>{t(locale, 'aura.tracklist')}</b><span class="lcd-text">{t(locale, 'aura.sideB')}</span></p>
        <ol>
          {aura.questions.map((q, i) => (
            <li><span class="n">{pad(i + 1)}</span> <b>{L(q.kicker).charAt(0) + L(q.kicker).slice(1).toLowerCase()}</b> · {L(q.text)}</li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ the eight questions ============ -->
    <section class="quiz" data-stage="quiz" hidden>
      <div class="quiz-head">
        <p class="qnum" aria-hidden="true"><span class="big" data-qn>Q01</span><span class="of">/ 08 · <span data-qk></span></span></p>
        <p class="progress-text" data-progress-text></p>
        <ol class="discs" aria-hidden="true">
          {aura.questions.map(() => <li class="disc"></li>)}
        </ol>
        <button type="button" class="btn btn-secondary btn-sm back" data-back><span aria-hidden="true">←</span> {t(locale, 'aura.back')}</button>
      </div>

      <div class="quiz-body">
        <div class="questions">
          {aura.questions.map((q, i) => (
            <div class="q" data-q={i} data-kind={q.kind} hidden>
              <h2 id={`aura-q${i}`} class="q-title" tabindex="-1">{L(q.text)}</h2>
              <div role="radiogroup" aria-labelledby={`aura-q${i}`} class:list={['opts', `k-${q.kind}`]}>
                {q.kind === 'notif' && (
                  <p class="lock-status" aria-hidden="true"><span>2:14</span><span class="batt"><span></span>3%</span></p>
                )}
                {q.options.map((o, j) => (
                  <label class:list={['opt', { lift: ['scene', 'swatch', 'postcard'].includes(q.kind) }]} data-era={o.era}>
                    <input class="visually-hidden" type="radio" name={`aura-q${i}`} value={j} />
                    {q.kind === 'scene' && <img class="art" src={`/stickers/${sceneArt[j]}.svg`} alt="" width="96" height="96" loading="lazy" />}
                    {q.kind === 'swatch' && <span class="sw" data-aura-skin={o.era} aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span></span>}
                    {q.kind === 'notif' && (
                      <span class="app" aria-hidden="true"><span class="app-icon" data-aura-skin={o.era}></span><span class="app-name">{o.art && L(o.art)}</span><span class="now">{t(locale, 'aura.now')}</span></span>
                    )}
                    {q.kind === 'postcard' && (
                      <span class="pc-front" aria-hidden="true"><span class="greet">{t(locale, 'aura.greetings')}</span><span class="state" data-aura-skin={o.era}>{o.art && L(o.art)}</span><span class="postmark"></span></span>
                    )}
                    {q.kind === 'fader' && (
                      <span class="strip-ch" aria-hidden="true"><span class="scribble">CH {j + 1}</span><span class="meter"><span></span></span><span class="slot"><span class="cap"></span></span></span>
                    )}
                    {q.kind === 'sticker' && <img class="art" src={`/stickers/${stickerArt[j]}.svg`} alt="" width="160" height="160" loading="lazy" />}
                    <span class="txt">
                      <span class="label">{L(o.label)}</span>
                      {o.sub && <span class="sub">{L(o.sub)}</span>}
                    </span>
                    <span class="key" aria-hidden="true">{keys[j]}</span>
                    <span class="tick" aria-hidden="true">✓</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- the polaroid that develops: each answer adds a blob in its era colour -->
        <figure class="polaroid developing" aria-hidden="true">
          <span class="tape"></span>
          <div class="photo dev" data-aura-skin="none">
            {aura.questions.map((_, i) => <span class:list={['dev-blob', `s${i}`]} data-dev={i}></span>)}
            <img class="shroom" src="/stickers/halo-shroom.svg" alt="" width="248" height="248" />
          </div>
          <figcaption class="hand">{t(locale, 'aura.develops')}</figcaption>
        </figure>
      </div>

      <div class="quiz-foot">
        <p class="keys-hint">{t(locale, 'aura.keys')}</p>
        <button type="button" class="btn btn-primary next" data-next disabled>{t(locale, 'aura.next')} <span aria-hidden="true">→</span></button>
      </div>
    </section>

    <!-- ============ result ============ -->
    <p class="visually-hidden" aria-live="polite" data-announce></p>
    <section class="result" data-stage="result" hidden>
      <figure class="polaroid res-photo" aria-hidden="true">
        <span class="tape"></span>
        <div class="photo developed" data-res-skin data-aura-skin="halo">
          <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
          <img class="shroom" src="/stickers/halo-shroom.svg" alt="" width="248" height="248" />
          <span class="stamp" data-stamp></span>
        </div>
        <figcaption class="hand" data-caption></figcaption>
      </figure>

      <div class="res-head">
        <div data-era-block>
          <p class="kicker">{t(locale, 'aura.yourEra')}</p>
          <h2 class="era-name" tabindex="-1" data-era-name></h2>
          <p class="era-meta"><span class="lcd" data-era-years></span> <span class="era-tag" data-era-tag></span></p>
          <p class="era-line" data-era-line></p>
        </div>
        <div data-solo-block hidden>
          <p class="kicker">{t(locale, 'aura.noEra')}</p>
          <h2 class="era-name fit-2" tabindex="-1">{t(locale, 'aura.soloTitle')}</h2>
          <p class="era-line">{t(locale, 'aura.soloLine')}</p>
        </div>
      </div>

      <article class="song-card" aria-labelledby="aura-song">
        <p class="kicker">{t(locale, 'aura.yourSong')}</p>
        <h3 id="aura-song" class="song-title"><span data-song-title></span> <abbr class="e-tag" title={t(locale, 'aura.explicit')} data-explicit hidden>E</abbr></h3>
        <p class="song-from" data-song-from></p>
        <p class="why" data-why></p>
        <PlayerGate locale={locale} title="" links={{ spotify: site.official.spotify.url ?? 'https://open.spotify.com/' }} inline>
          <a slot="beside" class="btn btn-secondary open-release" href="#" data-open-release>{t(locale, 'aura.openRelease')} <span aria-hidden="true">→</span></a>
        </PlayerGate>
      </article>

      <div class="mix" data-mix-block>
        <h3 class="mix-title">{t(locale, 'aura.mix')}</h3>
        <ul>
          {eras.map((e) => (
            <li data-mix={e.id}>
              <span class="mix-name">{e.name}</span>
              <span class="bar" data-aura-skin={e.id}><span data-mix-bar></span></span>
              <span class="pct" data-mix-pct>0%</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="res-actions">
        <button type="button" class="btn btn-hot" data-again><span aria-hidden="true">↻</span> {t(locale, 'aura.again')}</button>
        <button type="button" class="btn btn-secondary" data-make-card>{t(locale, 'aura.makeCard')}</button>
        <button type="button" class="btn btn-secondary" data-copy>{t(locale, 'aura.copy')}</button>
        <p class="copy-status" role="status" data-copy-status></p>
      </div>
    </section>

    <dialog class="card-dialog" aria-labelledby="aura-card-title" data-card-dialog>
      <div class="card-head">
        <h2 id="aura-card-title">{t(locale, 'aura.cardTitle')}</h2>
        <button type="button" class="btn btn-secondary btn-sm" data-card-close>{t(locale, 'aura.close')}</button>
      </div>
      <div class="formats" role="radiogroup" aria-label={t(locale, 'aura.cardTitle')}>
        <label class="lift fmt"><input class="visually-hidden" type="radio" name="aura-fmt" value="wide" checked /> {t(locale, 'aura.cardWide')} <small>1200×630</small></label>
        <label class="lift fmt"><input class="visually-hidden" type="radio" name="aura-fmt" value="story" /> {t(locale, 'aura.cardStory')} <small>1080×1350</small></label>
      </div>
      <canvas class="card-canvas" width="1200" height="630" role="img" data-card-canvas></canvas>
      <p class="card-note">{t(locale, 'aura.cardNote')}</p>
      <div class="card-actions">
        <button type="button" class="btn btn-primary" data-card-save>{t(locale, 'aura.cardSave')}</button>
        <button type="button" class="btn btn-secondary" data-card-share hidden>{t(locale, 'aura.cardShare')}</button>
      </div>
    </dialog>

    <!-- ============ every possible result (also the no-JS view) ============ -->
    <section class="deck" id="deck" aria-labelledby="deck-title">
      <h2 id="deck-title" class="deck-title">{t(locale, 'aura.deckTitle')}</h2>
      <p class="deck-lead">{t(locale, 'aura.deckLead', { n: String(aura.deck.length) })}</p>
      <div class="booklets">
        {byEra.map((e) => (
          <article class="booklet" aria-labelledby={`deck-${e.id}`}>
            <header>
              <span class="swatch" data-aura-skin={e.id} aria-hidden="true"></span>
              <h3 id={`deck-${e.id}`}>{e.name}</h3>
              <span class="count">{t(locale, 'aura.songs', { n: String(e.count) })}</span>
            </header>
            {e.releases.map((r) => (
              <div class="rel">
                <p class="rel-title">{r.title}</p>
                <ul class="songs">
                  {r.songs.map((s) => (
                    <li><a href={localePath(`/music/${s.release}/`, locale)}>{s.title}</a>{s.explicit && <abbr class="e-tag" title={t(locale, 'aura.explicit')}>E</abbr>}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))}
        <article class="booklet solo" aria-labelledby="deck-solo">
          <header>
            <span class="swatch" data-aura-skin="solo" aria-hidden="true"></span>
            <h3 id="deck-solo">{t(locale, 'aura.soloDeck')}</h3>
            <span class="count">{t(locale, 'aura.songs', { n: String(solo.length) })}</span>
          </header>
          <ul class="songs">
            {solo.map((s) => (
              <li><a href={localePath(`/music/${s.release}/`, locale)}>{s.title}</a> <span class="yr">{s.year}</span>{s.explicit && <abbr class="e-tag" title={t(locale, 'aura.explicit')}>E</abbr>}</li>
            ))}
          </ul>
          <p class="solo-note">{t(locale, 'aura.soloDeckNote')}</p>
        </article>
      </div>
    </section>
  </div>
</Base>

<script>
  import { read, type AuraEra, type DeckSong } from '../lib/aura';
  import { readJSON, writeJSON } from '../lib/storage';
  import { drawCard, type CardFormat } from '../scripts/aura-card';

  type Song = DeckSong & { fit: number; spotify: string | null; embed: string | null; href: string };
  type Era = { id: AuraEra; name: string; years: string; tag: string; line: string; fit: number };
  type Data = {
    feelings: { id: string; why: string }[];
    eras: Era[];
    questions: { kicker: string; options: { era: AuraEra; feelings: string[] }[] }[];
    deck: Song[];
    s: Record<string, string>;
    locale: 'en' | 'es';
  };
  type Saved = { era: AuraEra | null; song: string; date: string };

  const root = document.querySelector<HTMLElement>('[data-aura]');
  if (root) {
    const data = JSON.parse(root.querySelector('[data-aura-data]')!.textContent!) as Data;
    const $ = <T extends HTMLElement = HTMLElement>(sel: string, from: ParentNode = root) => from.querySelector<T>(sel)!;
    const fill = (key: string, vars: Record<string, string> = {}) => data.s[key]!.replace(/\{(\w+)\}/g, (_, k: string) => vars[k] ?? '');
    const order = data.feelings.map((f) => f.id);
    const why = Object.fromEntries(data.feelings.map((f) => [f.id, f.why]));
    const eraOf = Object.fromEntries(data.eras.map((e) => [e.id, e])) as Record<AuraEra, Era>;
    const lcdSafe = (s: string) => s.replace(/[‘’]/g, "'").toUpperCase();
    const lcd = (text: string) => dispatchEvent(new CustomEvent('shq:lcd', { detail: text }));

    const stages: Record<string, HTMLElement> = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-stage]')].map((el) => [el.dataset.stage!, el]));
    const questions = [...root.querySelectorAll<HTMLElement>('.q')];
    const discs = [...root.querySelectorAll<HTMLElement>('.disc')];
    const devBlobs = [...root.querySelectorAll<HTMLElement>('[data-dev]')];
    const next = $<HTMLButtonElement>('[data-next]');
    const start = $<HTMLButtonElement>('[data-start]');
    $('[data-nojs]').hidden = true;
    start.hidden = false;

    const answers: (number | undefined)[] = Array(questions.length).fill(undefined);
    let step = -1; // -1 intro, 0–7 questions, 8 result
    let last: { era: AuraEra | null; song: Song } | null = null;

    // the last reading (shq:aura) on the intro: a small return loop
    const saved = readJSON<Saved | null>('aura', null);
    const savedSong = saved && data.deck.find((s) => s.title === saved.song);
    if (savedSong) {
      $('[data-last]').hidden = false;
      const a = $<HTMLAnchorElement>('[data-last-link]');
      a.textContent = savedSong.title;
      a.href = savedSong.href;
    }

    const show = (name: 'intro' | 'quiz' | 'result') => {
      for (const [k, el] of Object.entries(stages)) el.hidden = k !== name;
      root.dataset.at = name;
    };

    const paintQuestion = (i: number) => {
      questions.forEach((q, j) => (q.hidden = j !== i));
      const kicker = data.questions[i]!.kicker;
      $('[data-qn]').textContent = `Q${String(i + 1).padStart(2, '0')}`;
      $('[data-qk]').textContent = kicker;
      $('[data-progress-text]').textContent = fill('progress', { n: String(i + 1), total: String(questions.length) });
      discs.forEach((d, j) => {
        d.dataset.state = j < i ? 'done' : j === i ? 'now' : 'todo';
        const a = answers[j];
        if (a === undefined) delete d.dataset.auraSkin;
        else d.dataset.auraSkin = data.questions[j]!.options[a]!.era;
      });
      devBlobs.forEach((b, j) => {
        const a = answers[j]; // later answers are cleared when one changes, so this is the picture so far
        if (a === undefined) delete b.dataset.auraSkin;
        else b.dataset.auraSkin = data.questions[j]!.options[a]!.era;
      });
      next.disabled = answers[i] === undefined;
      next.firstChild!.textContent = `${data.s[i === questions.length - 1 ? 'finish' : 'next']} `;
      lcd(`B1 · Q ${i + 1}/${questions.length}`);
    };

    const go = (to: number, push = true) => {
      step = to;
      if (push) history.pushState({ aura: to }, '');
      if (to < 0) {
        show('intro');
        lcd('B1 · AURA READING');
        start.focus();
      } else if (to < questions.length) {
        show('quiz');
        paintQuestion(to);
        $(`#aura-q${to}`).focus({ preventScroll: true });
        stages.quiz!.scrollIntoView({ block: 'start' });
      } else result();
    };

    const result = () => {
      const r = read(answers as number[], data.questions, data.deck, order) as ReturnType<typeof read> & { song: Song };
      const song = r.song;
      const solo = song.standalone;
      const era = eraOf[r.era];
      last = { era: solo ? null : r.era, song };
      show('result');
      const res = stages.result!;
      res.dataset.solo = String(solo);
      $('[data-res-skin]').dataset.auraSkin = solo ? 'solo' : r.era;
      $('[data-era-block]').hidden = solo;
      $('[data-solo-block]').hidden = !solo;
      $('[data-mix-block]').hidden = solo;
      const date = new Date().toLocaleDateString(data.locale, { day: 'numeric', month: 'short' }).toUpperCase().replace('.', '');
      $('[data-stamp]').textContent = fill('stamp', { date });
      $('[data-caption]').textContent = solo ? data.s.whiteLight! : era.tag;
      const name = $('[data-era-name]');
      name.textContent = era.name;
      name.className = `era-name fit-${era.fit}`;
      $('[data-era-years]').textContent = era.years;
      $('[data-era-tag]').textContent = era.tag;
      $('[data-era-line]').textContent = era.line;
      const title = $('[data-song-title]');
      title.textContent = song.title;
      title.parentElement!.className = `song-title fit-${song.fit}`;
      $('[data-explicit]').hidden = !song.explicit;
      $('[data-song-from]').textContent = solo ? fill('soloFrom', { year: song.year }) : fill('from', { release: song.releaseTitle, year: song.year });
      $('[data-why]').textContent = fill('because', { a: why[r.why[0]]!, b: why[r.why[1]]! });
      $<HTMLAnchorElement>('[data-open-release]').href = song.href;
      // the player gate of the result: re-armed for this song (nothing loads before the click)
      const gate = $('[data-gate]', res);
      for (const el of gate.querySelectorAll<HTMLElement>('[data-gate-load], .gate-small')) el.hidden = !song.embed; // no Spotify link: the release page only
      if (song.embed) {
        gate.dataset.gate = song.embed;
        gate.dataset.frameTitle = song.title;
        gate.toggleAttribute('data-tall', song.embed.includes('/album/')); // same rule as PlayerGate.astro
        gate.querySelector<HTMLAnchorElement>('[data-gate-fallback] a')!.href = song.spotify!;
        gate.dispatchEvent(new Event('gate:reset'));
      }
      for (const e of data.eras) {
        const row = $(`[data-mix="${e.id}"]`);
        $('[data-mix-bar]', row).style.inlineSize = `${r.mix[e.id]}%`; // CSSOM, allowed by the CSP
        $('[data-mix-pct]', row).textContent = `${r.mix[e.id]}%`;
        row.classList.toggle('win', e.id === r.era);
      }
      $('[data-copy-status]').textContent = '';
      $('[data-announce]').textContent = solo ? fill('announceSolo', { song: song.title }) : fill('announce', { era: era.name, song: song.title });
      lcd(/^[\x20-\x7e]+$/.test(lcdSafe(song.title)) ? `B1 · ${lcdSafe(song.title)}` : 'B1 · YOUR AURA');
      writeJSON('aura', { era: last.era, song: song.title, date: new Date().toISOString().slice(0, 10) } satisfies Saved);
      res.classList.remove('reveal');
      void res.offsetWidth; // restart the develop animation on "take it again"
      res.classList.add('reveal');
      res.scrollIntoView({ block: 'start' });
      $(solo ? '[data-solo-block] .era-name' : '[data-era-name]').focus({ preventScroll: true });
    };

    // ---- answering: pointer picks move on by themselves; keyboard picks wait for Next (no surprise jumps) ----
    let pointer = false;
    root.addEventListener('pointerdown', () => (pointer = true), true);
    root.addEventListener('keydown', () => (pointer = false), true);
    questions.forEach((q, i) => {
      q.addEventListener('change', (e) => {
        answers[i] = Number((e.target as HTMLInputElement).value);
        for (let j = i + 1; j < answers.length; j++) answers[j] = undefined; // a changed answer re-asks the rest
        paintQuestion(i);
        if (pointer) setTimeout(() => step === i && go(i + 1), 420);
      });
    });
    next.addEventListener('click', () => answers[step] !== undefined && go(step + 1));
    $('[data-back]').addEventListener('click', () => history.back());
    start.addEventListener('click', () => {
      answers.fill(undefined);
      for (const input of root.querySelectorAll<HTMLInputElement>('.q input')) input.checked = false;
      go(0);
    });
    $('[data-again]').addEventListener('click', () => start.click());
    addEventListener('popstate', (e) => {
      const to = (e.state as { aura?: number } | null)?.aura ?? -1;
      // never land on a question after an unanswered one, or on a result without all answers
      const firstGap = answers.findIndex((a) => a === undefined);
      go(firstGap === -1 ? to : Math.min(to, firstGap), false);
    });
    history.replaceState({ aura: -1 }, '');

    // shortcuts on a question: 1–4 / A–D pick, Enter next, Backspace back (never while typing; the remote's 1–7 wait)
    addEventListener(
      'keydown',
      (e) => {
        if (step < 0 || step >= questions.length || e.altKey || e.ctrlKey || e.metaKey) return;
        const t = e.target as HTMLElement;
        if (t.isContentEditable || t.closest('textarea, select, input:not([type="radio"]), dialog')) return;
        const k = e.key.toUpperCase();
        const i = '1234'.indexOf(k) >= 0 ? '1234'.indexOf(k) : k.length === 1 ? 'ABCD'.indexOf(k) : -1;
        if (/^[5-9]$/.test(k)) e.stopPropagation(); // the remote's 5–7 would leave the reading halfway
        if (i >= 0) {
          e.preventDefault();
          e.stopPropagation();
          const input = questions[step]!.querySelectorAll<HTMLInputElement>('input')[i]!;
          input.checked = true;
          input.focus();
          input.dispatchEvent(new Event('change', { bubbles: true }));
        } else if (e.key === 'Enter' && answers[step] !== undefined) {
          e.preventDefault();
          go(step + 1);
        } else if (e.key === 'Backspace') {
          e.preventDefault();
          history.back();
        }
      },
      true,
    );

    // ---- copy and the aura card ----
    const copyText = () => (last!.era ? fill('copyText', { era: eraOf[last!.era].name, song: last!.song.title }) : fill('copyTextSolo', { song: last!.song.title })) + ' — shroomieshq.fan/aura';
    $('[data-copy]').addEventListener('click', async () => {
      const status = $('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(copyText());
        status.textContent = data.s.copied!;
      } catch {
        status.textContent = `${data.s.copyFailed} ${copyText()}`;
      }
    });

    const dialog = $<HTMLDialogElement>('[data-card-dialog]');
    const canvas = $<HTMLCanvasElement>('[data-card-canvas]');
    const share = $<HTMLButtonElement>('[data-card-share]');
    let format: CardFormat = 'wide';
    const paintCard = async () => {
      const { era, song } = last!;
      await drawCard(canvas, format, {
        era: era && eraOf[era],
        aura: era ?? 'solo',
        song: song.title,
        caption: era ? eraOf[era].tag : data.s.whiteLight!,
        s: data.s,
      });
      canvas.setAttribute('aria-label', fill('cardAlt', { era: era ? eraOf[era].name : '—', song: song.title }));
    };
    const blob = () => new Promise<Blob | null>((ok) => canvas.toBlob(ok, 'image/png'));
    const fileName = () => `tiff-aura-${last!.song.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${format}.png`;
    $('[data-make-card]').addEventListener('click', async () => {
      dialog.showModal();
      await paintCard();
      const probe = new File([new Blob()], 'x.png', { type: 'image/png' });
      share.hidden = !navigator.canShare?.({ files: [probe] });
    });
    $('[data-card-close]').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close()); // a click on the backdrop
    for (const input of dialog.querySelectorAll<HTMLInputElement>('[name="aura-fmt"]')) {
      input.addEventListener('change', () => {
        format = input.value as CardFormat;
        paintCard();
      });
    }
    $('[data-card-save]').addEventListener('click', async () => {
      const b = await blob();
      if (!b) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(b);
      a.download = fileName();
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    share.addEventListener('click', async () => {
      const b = await blob();
      if (!b) return;
      try {
        await navigator.share({ files: [new File([b], fileName(), { type: 'image/png' })], text: copyText() });
      } catch {} // the visitor closed the share sheet
    });
  }
</script>

<style>
