  .batt { display: flex; align-items: center; gap: 0.375rem; color: #ff6a52; }
  .batt span { width: 1.625rem; height: 0.75rem; border: 2px solid currentColor; border-radius: 3px; background: linear-gradient(90deg, currentColor 12%, transparent 12%); }
  .k-notif .opt {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    padding: 0.75rem 3rem 0.875rem 0.875rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, #f4f4f7 88%, transparent);
    backdrop-filter: blur(6px);
    transition: transform 120ms, background 120ms;
  }
  .k-notif .opt:hover { transform: translateY(-2px); background: #ffffff; }
  .k-notif .app { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; color: #4a4b55; }
  .k-notif .app-icon { width: 1.25rem; height: 1.25rem; border-radius: 0.375rem; background: linear-gradient(135deg, var(--a1), var(--a2)); border: 1px solid rgb(0 0 0 / 0.2); }
  .k-notif .now { margin-inline-start: auto; font-weight: 400; letter-spacing: 0; }
  .k-notif .txt { grid-column: 1 / -1; }
  .k-notif .label { font: 700 1.0625rem var(--font-body); }
  .k-notif .key { top: 50%; translate: 0 -50%; }
  .k-notif .opt:has(:checked) { outline-color: var(--c-lcd-1); }

  /* postcard: greetings from four places */
  .k-postcard .opt { gap: 0.75rem; padding: 0.75rem 0.75rem 1rem; background: #fbf6e9; border: var(--border) solid var(--line); }
  .pc-front {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    aspect-ratio: 16 / 7;
    padding: 0.5rem;
    overflow: hidden;
    background: radial-gradient(90% 120% at 20% 0%, color-mix(in srgb, var(--a1) 45%, transparent), transparent), var(--a-bg);
    border: var(--border) solid var(--c-ink);
  }
  .pc-front[data-aura-skin], .k-postcard .pc-front { color: var(--c-flash); }
  .greet { font: 1.25rem/1 var(--font-hand); color: #fbf6e9; rotate: -4deg; }
  .state {
    font: 900 3.75rem/0.9 var(--font-display);
    font-stretch: 150%;
    color: transparent;
    background: linear-gradient(160deg, var(--a2), var(--a1) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 2px #fbf6e9;
    filter: drop-shadow(3px 3px 0 var(--c-ink));
  }
  .postmark { position: absolute; right: -0.75rem; bottom: -0.75rem; width: 3.5rem; height: 3.5rem; border: 2px dashed color-mix(in srgb, #fbf6e9 70%, transparent); border-radius: 50%; }
  .k-postcard .txt { padding-inline: 0.25rem 2.5rem; }
  .k-postcard .key { top: auto; bottom: 0.875rem; }

  /* post-its: what you do when someone hurts you */
  .k-postit { gap: 1.75rem; padding-top: 0.5rem; }
  .k-postit .opt {
    min-height: 10rem;
    padding: 1.75rem 1.25rem 1.25rem;
    background: var(--note, var(--c-lemon));
    box-shadow: 2px 10px 14px -8px rgb(0 0 0 / 0.45);
    rotate: var(--tilt);
    transition: rotate 160ms, translate 160ms;
  }
  .k-postit .opt::before { content: ''; position: absolute; top: -0.625rem; left: 50%; width: 5rem; height: 1.25rem; translate: -50% 0; rotate: -3deg; background: color-mix(in srgb, #ffffff 55%, transparent); border: 1px solid rgb(0 0 0 / 0.08); }
  .k-postit .opt:nth-child(1) { --note: #fff36b; --tilt: -2deg; }
  .k-postit .opt:nth-child(2) { --note: #ffb38f; --tilt: 1.5deg; }
  .k-postit .opt:nth-child(3) { --note: #b8f0a8; --tilt: 2deg; }
  .k-postit .opt:nth-child(4) { --note: #9fd6ff; --tilt: -1.5deg; }
  .k-postit .opt:hover { rotate: 0deg; translate: 0 -3px; }
  .k-postit .label { font: 400 clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem)/1.1 var(--font-hand); font-stretch: 100%; }
  .k-postit .sub { color: rgb(18 18 22 / 0.78); }
  .k-postit .key { top: auto; bottom: 0.625rem; }
  .k-postit .txt { padding-bottom: 1.5rem; }

  /* fader: a four-channel mixing desk */
  .k-fader {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    padding: 1.25rem 0.75rem 1rem;
    border-radius: 14px;
    background: linear-gradient(180deg, var(--c-remote-hi), var(--c-remote-lo));
    border: 1px solid var(--c-remote-edge);
    box-shadow: 0 4px 0 var(--c-remote-edge), 8px 10px 0 var(--c-strobe);
  }
  .k-fader .opt { justify-items: center; gap: 0.75rem; padding: 0.25rem 0.75rem 3rem; color: var(--c-flash); text-align: center; border-inline-start: 1px solid var(--c-remote-line); }
  .k-fader .opt:first-of-type { border-inline-start: 0; }
  .strip-ch { display: grid; justify-items: center; gap: 0.625rem; width: 100%; }
  .scribble { width: 100%; padding: 0.125rem; font: 1rem var(--font-lcd); color: var(--c-lcd-ink); background: linear-gradient(var(--c-lcd-1), var(--c-lcd-2)); border-radius: 3px; }
  .meter { display: block; width: 0.5rem; height: 2.25rem; border-radius: 2px; background: #1a1b22; overflow: hidden; }
  .meter span { display: block; height: 100%; translate: 0 100%; background: linear-gradient(#ff4a1c, #fff36b 35%, #c7f26a 70%); transition: translate 400ms; }
  .slot { position: relative; display: block; width: 0.5rem; height: 9rem; border-radius: 4px; background: #050507; box-shadow: inset 0 1px 3px #000; }
  .cap {
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 2.75rem;
    height: 1.375rem;
    translate: -50% 50%;
    border-radius: 4px;
    background: linear-gradient(#e3e4ea, #8f91a3);
    box-shadow: 0 3px 0 #050507, inset 0 -3px 0 rgb(0 0 0 / 0.25);
    transition: bottom 420ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .cap::after { content: ''; position: absolute; inset: 45% 10%; height: 2px; background: var(--c-ink); }
  .k-fader .opt:hover .cap { bottom: 16%; }
  .k-fader .opt:has(:checked) .cap { bottom: 88%; background: linear-gradient(var(--c-flash), var(--c-lcd-1)); }
  .k-fader .opt:has(:checked) .meter span { translate: 0 10%; }
  .k-fader .label { font-size: 1rem; }
  .k-fader .sub { color: var(--c-remote-label); font-size: 0.8125rem; }
  .k-fader .key { top: auto; bottom: 0.5rem; right: 50%; translate: 50% 0; }
  .k-fader .tick { left: auto; right: -0.25rem; top: -0.75rem; }
  .k-fader .opt:has(:checked) { outline-color: var(--c-lcd-1); outline-offset: -2px; }
  .k-fader .opt:has(:focus-visible) { transform: none; box-shadow: inset 0 0 0 3px var(--c-strobe); }

  /* speech bubbles: what people get wrong */
  .k-bubble { gap: 1.5rem 2rem; }
  .k-bubble .opt {
    min-height: 7rem;
    align-content: center;
    padding: 1.25rem 3rem 1.25rem 1.5rem;
    background: var(--surface);
    color: var(--ink);
    border: var(--border-strong) solid var(--line);
    border-radius: 2rem;
    transition: transform 140ms;
  }
  /* the tail: an ink triangle with a paper one inside, so the bubble's border opens into it */
  .k-bubble .opt::before, .k-bubble .opt::after { content: ''; position: absolute; top: 100%; left: 2rem; width: 1.75rem; height: 1.375rem; clip-path: polygon(0 0, 100% 0, 15% 100%); }
  .k-bubble .opt::before { margin-top: -1px; background: var(--line); }
  .k-bubble .opt::after { left: calc(2rem + 4px); width: calc(1.75rem - 9px); height: calc(1.375rem - 5px); margin-top: -4px; background: var(--surface); }
  .k-bubble .opt:nth-child(even)::before, .k-bubble .opt:nth-child(even)::after { left: auto; right: 2rem; clip-path: polygon(0 0, 100% 0, 85% 100%); }
  .k-bubble .opt:nth-child(even)::after { right: calc(2rem + 4px); }
  .k-bubble .opt:hover { transform: rotate(-1deg) scale(1.02); }
  .k-bubble .label { font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.625rem); }
  .k-bubble .label::before { content: '“'; margin-inline-end: 0.125rem; color: var(--c-aura-text); }
  :global([data-theme='dark']) .k-bubble .label::before { color: var(--hot); }
  .k-bubble .key { top: 50%; translate: 0 -50%; right: 1rem; }

  /* stickers: pick one for your backpack */
  .k-sticker {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 1.5rem 1rem 1.25rem;
    background:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.04) 0 2px, transparent 2px 6px),
      linear-gradient(160deg, #3a4f7a, #24324f);
    border: var(--border) solid var(--line);
    border-radius: 1.5rem;
    outline: 2px dashed rgb(255 255 255 / 0.35);
    outline-offset: -0.75rem;
    box-shadow: 8px 8px 0 var(--shadow);
  }
  .k-sticker .opt { justify-items: center; text-align: center; padding: 0.5rem 0.25rem 2.5rem; color: var(--c-flash); border-radius: 1rem; }
  .k-sticker .art { width: min(100%, 8.5rem); height: auto; transition: rotate 200ms, scale 200ms; }
  .k-sticker .opt:nth-child(odd) .art { rotate: -5deg; }
  .k-sticker .opt:nth-child(even) .art { rotate: 4deg; }
  .k-sticker .opt:hover .art, .k-sticker .opt:has(:checked) .art { rotate: 0deg; scale: 1.08; }
  .k-sticker .label { font-size: 1rem; }
  .k-sticker .sub { color: #dfe4f2; font-size: 0.8125rem; }
  .k-sticker .key { top: auto; bottom: 0.5rem; right: 50%; translate: 50% 0; }
  .k-sticker .opt:has(:checked) { outline-color: var(--c-lcd-1); outline-offset: 0; }
  .k-sticker .opt:has(:focus-visible) { transform: none; box-shadow: none; background: rgb(255 255 255 / 0.12); }

  /* ================= result ================= */
  .result {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-areas: 'photo head' 'photo song' 'mix song' 'actions actions';
    gap: 2rem 3rem;
    align-items: start;
    scroll-margin-top: 1rem;
  }
  .res-photo { grid-area: photo; width: min(100%, 24rem); justify-self: center; rotate: -2.5deg; }
  .stamp { position: absolute; top: 0.75rem; left: 0.75rem; z-index: 3; padding: 0.125rem 0.375rem; font: 1rem/1 var(--font-lcd); letter-spacing: 0.04em; color: var(--c-flash); background: rgb(0 0 0 / 0.45); }
  .res-head { grid-area: head; min-width: 0; container-type: inline-size; }
  .era-name { font-size: min(6rem, 19cqi); font-stretch: 150%; letter-spacing: -0.025em; line-height: 0.88; text-transform: uppercase; overflow-wrap: break-word; text-wrap: balance; }
  .era-name:focus { outline: none; }
  .era-name.fit-1 { font-size: min(5rem, 14cqi); }
  .era-name.fit-2 { font-size: min(4.25rem, 11cqi); }
  .era-name.fit-3 { font-size: min(3.5rem, 9cqi); }
  .era-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 0.875rem; font-weight: 700; }
  .era-meta .lcd { font-size: 1.125rem; }
  .era-line { max-width: 32rem; margin-top: 0.75rem; font-size: 1.0625rem; }
  [data-solo-block] .era-line { color: var(--muted); }

  .song-card {
    grid-area: song;
    display: grid;
    gap: 0.625rem;
    padding: 1.5rem 1.5rem 1.75rem;
    background: var(--c-ink);
    color: var(--c-flash);
    border: var(--border) solid var(--line);
    box-shadow: 8px 8px 0 var(--c-strobe);
    container-type: inline-size;
  }
  .song-card .kicker { color: #ff8a6a; }
  .song-title { font-size: min(4.25rem, 13cqi); font-stretch: 150%; letter-spacing: -0.02em; line-height: 0.9; text-transform: uppercase; overflow-wrap: break-word; text-wrap: balance; }
  .song-title.fit-1 { font-size: min(3.5rem, 10.5cqi); }
  .song-title.fit-2 { font-size: min(2.75rem, 8.5cqi); }
  .song-title.fit-3 { font-size: min(2.25rem, 7cqi); }
  .e-tag {
    display: inline-grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    margin-inline-start: 0.375rem;
    vertical-align: 0.25em;
    font: 700 0.875rem/1 var(--font-body);
    font-stretch: 100%;
    text-decoration: none;
    color: var(--c-ink);
    background: var(--c-paper);
    border-radius: 3px;
  }
  .song-from { font-size: 0.9375rem; color: var(--c-remote-label); }
  .why { max-width: 34rem; padding: 0.75rem 0 0.25rem; border-top: 1px dashed var(--c-remote-line); font-size: 1.0625rem; }
  .song-card :global(.gate) { margin-top: 0.5rem; }
  .song-card :global(.gate-small), .song-card :global(.gate-fallback) { color: var(--c-remote-label); }
  .song-card :global(.gate a:not(.btn)) { color: var(--c-flash); }
  .open-release { background: var(--c-flash); color: var(--c-ink); box-shadow: 4px 4px 0 var(--c-strobe); }
  .open-release:hover { box-shadow: 5px 6px 0 var(--c-strobe); }

  .mix { grid-area: mix; display: grid; gap: 0.75rem; padding: 1.25rem; background: var(--surface); border: var(--border) solid var(--line); box-shadow: var(--shadow-md); }
  .mix-title { font-size: 1.125rem; font-stretch: 125%; text-transform: uppercase; }
  .mix ul { display: grid; gap: 0.625rem; padding: 0; list-style: none; }
  .mix li { display: grid; grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr) 3rem; align-items: center; gap: 0.75rem; font-size: 0.875rem; }
  .mix-name { font-weight: 700; overflow-wrap: anywhere; }
  .bar { height: 1rem; background: color-mix(in srgb, var(--ink) 10%, transparent); border: 1px solid var(--line); }
  .bar span { display: block; height: 100%; inline-size: 0; background: linear-gradient(90deg, var(--a1), var(--a2)); transition: inline-size 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 300ms; }
  .pct { font: 1.125rem var(--font-lcd); text-align: end; }
  .mix li.win .mix-name::after { content: ' ★'; color: var(--c-aura-text); }
  :global([data-theme='dark']) .mix li.win .mix-name::after { color: var(--hot); }

  .res-actions { grid-area: actions; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding-top: 1.5rem; border-top: var(--border-strong) solid var(--line); }
  .copy-status { font-weight: 700; }

  /* the reveal: the polaroid develops from grey, the rest fades in after it */
  @keyframes develop { from { filter: grayscale(1) brightness(0.35) contrast(1.4); } 60% { filter: grayscale(0.4) brightness(1.2); } to { filter: none; } }
  @keyframes rise { from { opacity: 0; translate: 0 12px; } }
  .result.reveal .developed { animation: develop 1.8s ease-out both; }
  .result.reveal :is(.res-head, .song-card, .mix) { animation: rise 500ms ease-out both; }
  .result.reveal .res-head { animation-delay: 500ms; }
  .result.reveal .song-card { animation-delay: 800ms; }
  .result.reveal .mix { animation-delay: 1100ms; }
  .result[data-solo='true'] { grid-template-areas: 'photo head' 'photo song' 'actions actions'; }

  /* ---------- the aura card dialog ---------- */
  .card-dialog {
    width: min(100% - 2rem, 46rem);
    max-height: calc(100dvh - 2rem);
    padding: 1.25rem;
    background: var(--surface);
    color: var(--ink);
    border: var(--border) solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .card-dialog::backdrop { background: rgb(18 18 22 / 0.6); }
  .card-dialog[open] { display: grid; gap: 1rem; }
  .card-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .card-head h2 { font-size: 1.5rem; font-stretch: 125%; }
  .formats { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .fmt { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.875rem; font-weight: 700; background: var(--surface); border: var(--border) solid var(--line); }
  .fmt small { font: 1rem var(--font-lcd); color: var(--muted); }
  .fmt:has(:checked) { background: var(--accent); color: var(--on-accent); }
  .fmt:has(:checked) small { color: inherit; }
  .fmt:has(:focus-visible) { transform: translate(-1px, -2px); box-shadow: 5px 6px 0 var(--accent); }
  .card-canvas { justify-self: center; width: auto; max-width: 100%; max-height: 52dvh; height: auto; border: var(--border) solid var(--line); background: var(--c-paper); }
  .card-note { font-size: var(--fs-small); color: var(--muted); }
  .card-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* ================= every possible result ================= */
  .deck { margin-top: 5rem; scroll-margin-top: 1rem; }
  .aura[data-at='quiz'] .deck { display: none; } /* no spoilers (and no distraction) while answering */
  .aura[data-at='result'] .deck { margin-top: 6rem; }
  .deck-title { font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem); font-stretch: 150%; letter-spacing: -0.02em; text-transform: uppercase; line-height: 0.95; }
  .deck-lead { max-width: 40rem; margin-top: 0.75rem; color: var(--muted); }
  .booklets { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2rem; align-items: start; }
  .booklet { display: grid; gap: 0.875rem; padding: 1.125rem; background: var(--surface); border: var(--border) solid var(--line); box-shadow: var(--shadow-md); min-width: 0; }
  .booklet header { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 0.25rem 0.625rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--line); }
  .booklet h3 { font-size: 1.125rem; font-stretch: 125%; text-transform: uppercase; line-height: 1; overflow-wrap: break-word; }
  .booklet .count { grid-column: 2; font: 1rem var(--font-lcd); color: var(--muted); }
  .booklet header .swatch { grid-row: span 2; }
  .rel-title { margin-bottom: 0.25rem; font-size: 0.8125rem; font-weight: 700; }
  .songs { display: flex; flex-wrap: wrap; gap: 0.125rem 0; padding: 0; list-style: none; font-size: 0.8125rem; line-height: 1.6; }
  .songs li:not(:last-child)::after { content: '·'; margin-inline: 0.375rem; color: var(--muted); }
  .songs a { text-decoration: none; text-transform: uppercase; }
  .songs a:hover { text-decoration: underline; }
  .songs .yr { font-family: var(--font-lcd); color: var(--muted); }
  .booklet .e-tag { width: 1rem; height: 1rem; margin-inline-start: 0.25rem; font-size: 0.6875rem; vertical-align: 0.125em; color: var(--c-flash); background: var(--c-ink); }
  :global([data-theme='dark']) .booklet .e-tag { color: var(--c-ink); background: var(--c-paper); }
  .booklet.solo { grid-column: 1 / -1; border-style: dashed; box-shadow: none; background: color-mix(in srgb, var(--surface) 60%, transparent); }
  .booklet.solo header { grid-template-columns: auto auto 1fr; }
  .booklet.solo .count { grid-column: auto; }
  .booklet.solo header .swatch { grid-row: auto; }
  .solo-note { font-size: var(--fs-small); color: var(--muted); }

  /* ================= smaller screens ================= */
  @media (max-width: 60rem) {
    .booklets { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quiz-body { grid-template-columns: minmax(0, 1fr); }
    .developing { display: none; }
    .k-swatch, .k-sticker { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .k-sticker { row-gap: 0.5rem; }
  }
  @media (max-width: 48rem) {
    .intro { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'photo' 'auras' 'strip'; }
    .hero { width: min(80%, 20rem); margin-top: 2.5rem; }
    .develops { display: none; }
    .strip { grid-template-columns: minmax(0, 1fr); padding: 1.25rem; }
    .strip ol { grid-template-columns: minmax(0, 1fr); }
    .quiz-head { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'num back' 'discs discs' 'text text'; gap: 0.75rem 1rem; }
    .back { justify-self: end; }
    .discs { gap: 0; justify-content: space-between; }
    .k-scene, .k-postcard, .k-bubble, .k-notif { grid-template-columns: minmax(0, 1fr); gap: 0.875rem; }
    .k-swatch .sw { aspect-ratio: 5 / 3; }
    .k-sticker .art { width: min(100%, 6.5rem); }
    .k-scene .opt { grid-template-columns: 4rem minmax(0, 1fr); align-items: center; min-height: 0; padding: 0.875rem 3rem 0.875rem 0.875rem; }
    .k-scene .art { width: 4rem; margin: 0; }
    .k-postit { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1rem; }
    .k-postit .opt { min-height: 8.5rem; padding: 1.5rem 0.875rem 1rem; }
    .k-postcard .opt { grid-template-columns: 7.5rem minmax(0, 1fr); align-items: center; gap: 0.875rem; padding: 0.625rem; }
    .k-postcard .pc-front { aspect-ratio: 1; }
    .k-postcard .txt { padding-inline: 0 2.25rem; }
    .greet { font-size: 0.875rem; }
    .state { font-size: 2.5rem; }
    .k-bubble { gap: 1.5rem; }
    .k-bubble .opt { min-height: 0; padding-block: 1rem; }
    /* phones: the desk turns into four rows with horizontal faders that slide right when picked */
    .k-fader { grid-template-columns: minmax(0, 1fr); padding: 0.5rem 0.75rem; }
    .k-fader .opt { grid-template-columns: minmax(0, 1fr) 6.5rem; align-items: center; justify-items: stretch; gap: 0.75rem; padding: 0.875rem 2.75rem 0.875rem 0.5rem; text-align: start; border-inline-start: 0; border-top: 1px solid var(--c-remote-line); }
    .k-fader .opt:first-of-type { border-top: 0; }
    .k-fader .strip-ch { order: 2; }
    .k-fader :is(.scribble, .meter) { display: none; }
    .k-fader .slot { width: 100%; height: 0.5rem; }
    .k-fader .cap, .k-fader .opt:hover .cap, .k-fader .opt:has(:checked) .cap { bottom: 50%; width: 1.25rem; height: 2rem; }
