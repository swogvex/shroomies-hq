---
// /music/<release>/ (08-spec-music): cover, player gate, meta, fan note, credits, tracklist with lyrics links (never lyrics).
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import PlayerGate from '../components/PlayerGate.astro';
import { localePath, t, type Locale } from '../i18n';
import { formatDate } from '../lib/dates';
import { discography, duration, songsOfDays, titleFit } from '../lib/music';

const { slug } = Astro.props as { slug: string };
const locale = (Astro.currentLocale ?? 'en') as Locale;
const releases = await discography();
const i = releases.findIndex((r) => r.slug === slug);
const r = releases[i]!;
const prev = releases[i - 1];
const next = releases[i + 1];
const site = (await getEntry('site', 'site'))!.data;
const Note = r.note?.body?.trim() ? (await render(r.note)).Content : undefined; // a file may only carry links, with no fan note yet
const year = r.date.slice(0, 4);
const fit = (['fit-s', 'fit-m', 'fit-l', 'fit-xl'] as const)[titleFit(r.title)]; // its longest word never breaks

// song of the day on this release for yesterday, today and tomorrow (UTC); the script picks the visitor's local date
const days = await songsOfDays();
const today = Object.fromEntries(Object.entries(days).flatMap(([date, s]) => (s.release === r.slug ? [[date, s.n]] : [])));
const buildDay = Object.keys(days)[1]!;

const producers = [...new Set(r.credits.filter((c) => c.role === 'producer').map((c) => c.name))];
const others = r.credits.filter((c) => c.role !== 'producer');
const meta = [
  formatDate(r.date, locale, { day: 'numeric', month: 'long', year: 'numeric' }),
  r.artistCredit !== 'Tiffany Day' && t(locale, 'release.by', { artist: r.artistCredit }),
  r.label ?? t(locale, 'release.selfReleased'),
  r.tracks.length === 1 ? t(locale, 'release.track') : t(locale, 'release.tracks', { n: String(r.tracks.length) }),
  r.durationMs && duration(r.durationMs),
].filter(Boolean);

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': r.tracks.length > 1 ? 'MusicAlbum' : 'MusicRecording',
  name: r.title,
  url,
  datePublished: r.date,
  byArtist: { '@type': 'MusicGroup', name: 'Tiffany Day', sameAs: [site.official.site.url, site.official.spotify.url].filter(Boolean) },
  ...(r.tracks.length > 1
    ? { numTracks: r.tracks.length, track: r.tracks.map((tr) => ({ '@type': 'MusicRecording', name: tr.title, position: tr.n })) }
    : {}),
};
---

<Base title={`${r.title} · ${t(locale, 'nav.music')} · Shroomies HQ`} description={t(locale, 'release.description', { title: r.title, year })}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <div class="release" data-era={r.era}>
    <p class="crumbs"><a href={localePath('/music/', locale)}>{t(locale, 'nav.music')}</a> / <span aria-current="page">{r.title}</span></p>

    <div class="layout">
      <div class="head">
        <p class="meta"><span class="lcd">{t(locale, `type.${r.type}`).toUpperCase()}</span> {meta.join(' · ')}</p>
        <h1 class={fit}>{r.title}</h1>
      </div>
      <div class="side">
        <figure class="case">
          <!-- a closed jewel case: hinge knuckles on the spine, the lid's lip, light on the acrylic -->
          <span class="knuckle knuckle-top" aria-hidden="true"></span><span class="knuckle knuckle-bottom" aria-hidden="true"></span>
          <span class="glint" aria-hidden="true"></span>
          <Cover image={r.image} title={r.title} alt={t(locale, 'release.coverAlt', { title: r.title })} widths={[360, 720]} sizes="(min-width: 52rem) 360px, min(19rem, 80vw)" eager />
          {r.note?.data.coverCredit ? <figcaption>{r.note.data.coverCredit}</figcaption> : r.image && <figcaption>{t(locale, 'release.coverSource')}</figcaption>}
        </figure>
        <PlayerGate locale={locale} title={r.title} links={r.listen} artistSpotify={site.official.spotify.url} />
      </div>

      <div class="main">

        {
          Note && (
            <div class="fan-note">
              <p class="fan-note-label">{t(locale, 'release.fanNote')}</p>
              <div class="fan-note-text"><Note /></div>
            </div>
          )
        }

        {
          (producers.length > 0 || others.length > 0) && (
            <div class="credits">
              <h2 class="visually-hidden">{t(locale, 'release.credits')}</h2>
              {producers.length > 0 && <p><b>{t(locale, 'release.producers')}</b> · {producers.join(', ')}</p>}
              {others.length > 0 && <p class="others">{others.map((c) => `${c.name} (${c.role})`).join(', ')}</p>}
            </div>
          )
        }

        <h2 class="visually-hidden" id="tracklist">{t(locale, 'release.tracklist')}</h2>
        <ol class="tracks" aria-labelledby="tracklist" data-today={JSON.stringify(today)} data-today-label={t(locale, 'release.todayLabel')}>
          {
            r.tracks.map((tr) => (
              <li id={`t${tr.n}`} class:list={{ today: today[buildDay] === tr.n }}>
                <b class="n">{String(tr.n).padStart(2, '0')}</b>
                <span class="title" lang="en">{tr.title}</span>
                <span class="lcd today-chip" title={t(locale, 'release.todayLabel')}>{t(locale, 'release.today')}</span>
                {r.lyrics[tr.n] && <a class="lyrics" href={r.lyrics[tr.n]} rel="noopener">{t(locale, 'release.lyrics')} ↗</a>}
                <span class="dur">{tr.durationMs ? duration(tr.durationMs) : ''}</span>
              </li>
            ))
          }
        </ol>
        <p class="note">{t(locale, 'release.tracklistNote')}</p>

        <nav class="pager" aria-label={t(locale, 'nav.music')}>
          {prev && <a class="btn btn-secondary" href={localePath(`/music/${prev.slug}/`, locale)} rel="prev"><span aria-hidden="true">←</span><span class="visually-hidden">{t(locale, 'release.prev')}:</span> {prev.title}</a>}
          {next && <a class="btn btn-secondary next" href={localePath(`/music/${next.slug}/`, locale)} rel="next"><span class="visually-hidden">{t(locale, 'release.next')}:</span> {next.title} <span aria-hidden="true">→</span></a>}
        </nav>
      </div>
    </div>
  </div>
</Base>

<script>
  import { localDateKey } from '../lib/dates';

  // The page was built for the UTC date: move the TODAY marker to the visitor's own date.
  const list = document.querySelector<HTMLElement>('[data-today]');
  if (list) {
    const n = (JSON.parse(list.dataset.today!) as Record<string, number>)[localDateKey()];
    for (const li of list.querySelectorAll('li')) li.classList.toggle('today', li.id === `t${n}`);
  }
</script>

<script>
  // the case's glint follows a mouse pointer (touch screens keep the slow drift); never in calm mode
  const jewel = document.querySelector<HTMLElement>('.case');
  if (jewel && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    jewel.addEventListener('pointermove', (e) => {
      if (document.documentElement.hasAttribute('data-calm') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const r = jewel.getBoundingClientRect();
      jewel.dataset.follow = '';
      jewel.style.setProperty('--gx', `${((((e.clientX - r.left) / r.width) - 0.5) * 18).toFixed(1)}%`); // gentle: half the drift's range // CSSOM, allowed by the CSP
    });
    const glint = jewel.querySelector<HTMLElement>('.glint')!;
    jewel.addEventListener('pointerleave', () => {
      if (!('follow' in jewel.dataset)) return;
      // where the band really is right now (mid-glide), not where it was heading: no jump when the pointer leaves
      const cs = getComputedStyle(glint, '::before');
      const tx = new DOMMatrixReadOnly(cs.transform === 'none' ? undefined : cs.transform).m41;
      const from = (tx / parseFloat(cs.width)) * 100;
      jewel.dataset.drift = '';
      delete jewel.dataset.follow;
      // carry on from there at the drift's own speed (36 % in 7 s), to one end, then back and forth as before
      const to = from >= 0 ? 18 : -18;
      const leg = glint.animate([{ transform: `translateX(${from}%)` }, { transform: `translateX(${to}%)` }], { duration: Math.max(300, (Math.abs(to - from) / 36) * 7000), easing: 'ease-out', pseudoElement: '::before', fill: 'forwards' });
      leg.onfinish = () => {
        if (!('drift' in jewel.dataset)) return;
        glint.animate([{ transform: `translateX(${to}%)` }, { transform: `translateX(${-to}%)` }], { duration: 7000, easing: 'ease-in-out', iterations: Infinity, direction: 'alternate', pseudoElement: '::before' });
      };
    });
    jewel.addEventListener('pointerenter', () => {
      const cs = getComputedStyle(glint, '::before');
      const tx = new DOMMatrixReadOnly(cs.transform === 'none' ? undefined : cs.transform).m41;
      jewel.style.setProperty('--gx', `${((tx / parseFloat(cs.width)) * 100).toFixed(1)}%`); // start from where it is
      jewel.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      delete jewel.dataset.drift;
    });
  }
</script>

<style>
  .release { width: var(--column); margin-inline: auto; display: grid; gap: 2rem; padding-block: 0.5rem 1rem; }
  .crumbs { font-size: var(--fs-small); color: var(--muted); }
  .layout {
    display: grid;
    grid-template: 'side head' auto 'side main' 1fr / minmax(0, 5fr) minmax(0, 7fr);
    gap: 1.25rem 2.25rem;
    align-items: start;
  }
  .head { grid-area: head; display: grid; gap: 1rem; min-width: 0; container-type: inline-size; }
  .side { grid-area: side; }
  .main { grid-area: main; }
  .side, .main { display: grid; gap: 1.25rem; min-width: 0; }

  /* jewel case: clear acrylic with the cover booklet inside. On the left, the hinge spine in smoky plastic (fine ribs,
     two knuckles, a lit edge where it meets the lid); over everything, the glint of light on acrylic. The shadow is the
     shared large one; the margin keeps it inside the column on phones. */
  .case {
    --plastic: color-mix(in srgb, var(--ink) 30%, var(--surface));
    position: relative;
    margin-inline-end: 8px;
    padding: 0.875rem 0.875rem 0.875rem 1.875rem;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.08) 45%, rgb(255 255 255 / 0.3)), var(--surface);
    border: var(--border) solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .case::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 1.375rem;
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.07) 0 1px, transparent 1px 4px),
      linear-gradient(90deg, #15161c, #3e404c 38%, #24252e 70%, #1b1c23);
    box-shadow: inset -1px 0 0 rgb(255 255 255 / 0.3), inset 1px 0 0 rgb(255 255 255 / 0.12), 1px 0 0 rgb(0 0 0 / 0.35);
  }
  /* the hinge knuckles stick out of the spine, top and bottom, like on a real case */
  .knuckle {
    position: absolute;
    z-index: 2;
    left: calc(-1 * var(--border) - 5px);
    width: 8px;
    height: 1.75rem;
    border-radius: 4px 0 0 4px;
    background: linear-gradient(90deg, #8f91a3, #e3e4ea 45%, #a3a6b3);
    border: 1px solid var(--line);
    border-right: 0;
  }
  .knuckle-top { top: 0.75rem; }
  .knuckle-bottom { bottom: 0.75rem; }
  /* light on acrylic, above the cover: a corner sheen, lit edges, and a feathered band of light that drifts on its own
     and follows a mouse (the band moves with transform, so it costs the main thread nothing); still in calm mode */
  .glint {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: screen;
    background:
      radial-gradient(130% 70% at 0% 0%, rgb(255 255 255 / calc(0.5 * var(--glint, 1))), transparent 60%),
      radial-gradient(60% 40% at 100% 100%, rgb(255 255 255 / calc(0.22 * var(--glint, 1))), transparent 70%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / calc(0.75 * var(--glint, 1))), inset 1px 0 0 rgb(255 255 255 / calc(0.45 * var(--glint, 1)));
  }
  .glint::after {
    content: '';
    position: absolute;
    inset: 0.3rem 0.3rem 0.3rem calc(1.375rem + 0.3rem);
    /* the lid's lip: a fine dark edge with a light one inside, so it reads on white and on dark plastic alike */
    border: 1px solid var(--lip, rgb(18 18 22 / 0.22));
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.7), 0 1px 0 rgb(255 255 255 / 0.6);
  }
  .glint::before {
    content: '';
    position: absolute;
    inset: 0 -100%;
    background: linear-gradient(118deg, transparent 43%, rgb(255 255 255 / calc(0.14 * var(--glint, 1))) 46.5%, rgb(255 255 255 / calc(0.34 * var(--glint, 1))) 50%, rgb(255 255 255 / calc(0.14 * var(--glint, 1))) 53.5%, transparent 57%);
    animation: glint-drift 7s ease-in-out infinite alternate;
  }
  @keyframes glint-drift { from { transform: translateX(-18%); } to { transform: translateX(18%); } }
  .case[data-follow] .glint::before { animation: none; transform: translateX(var(--gx, 0%)); transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1); } /* a slow, damped glide behind the pointer */
  .case[data-drift] .glint::before { animation: none; } /* the script carries the drift on from where the pointer left it */
  :global(html[data-calm]) .glint::before { animation: none; }
  @media (prefers-reduced-motion: reduce) { .glint::before { animation: none; } }
  .case :global(.cover) { position: relative; border: 1px solid var(--line); }
  :global([data-theme='dark']) .case { --glint: 0.45; --lip: rgb(255 255 255 / 0.3); }
  /* on light pages the clear frame is a touch grey, so the acrylic and its edges show */
  :global(:is([data-theme='original'], [data-theme='light'])) .case { background: linear-gradient(135deg, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.1) 45%, rgb(255 255 255 / 0.4)), color-mix(in srgb, var(--ink) 6%, var(--surface)); }
  :global(:is([data-theme='original'], [data-theme='light'])) .glint { box-shadow: inset 0 1px 0 #fff, inset 1px 0 0 #fff, inset 0 -1px 0 rgb(18 18 22 / 0.12), inset -1px 0 0 rgb(18 18 22 / 0.12); }
  figcaption { margin-top: 0.5rem; font-size: var(--fs-small); color: var(--muted); }

  .meta { font-size: 0.9375rem; }
  .meta .lcd { font-size: 1.0625rem; padding-block: 0; margin-inline-end: 0.25rem; }
  h1 { font-stretch: 150%; letter-spacing: -0.025em; line-height: 0.92; overflow-wrap: anywhere; text-wrap: balance; }
  .fit-s { font-size: min(7.5rem, 17cqi); }
  .fit-m { font-size: min(7.5rem, 11cqi); }
  .fit-l { font-size: min(7.5rem, 8.2cqi); }
  .fit-xl { font-size: min(7.5rem, 6.4cqi); }

  /* the fan note is a yellow paper slip: same in every theme */
  .fan-note { padding: 1rem 1.125rem; background: var(--c-lemon); color: var(--c-ink); rotate: -0.8deg; box-shadow: 3px 5px 0 color-mix(in srgb, var(--c-ink) 25%, transparent); }
  .fan-note-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; margin-bottom: 0.25rem; }
  .fan-note-text { font: 400 1.1875rem / 1.35 var(--font-hand); }
  html[data-calm] .fan-note { rotate: none; }

  .credits { display: grid; gap: 0.25rem; font-size: 0.9375rem; }
  .others { color: var(--muted); font-size: var(--fs-small); }

  /* the tracklist is the remote's display: dark in every theme */
  .tracks { padding: 0; list-style: none; background: var(--c-ink); color: var(--c-flash); border: var(--border) solid var(--line); }
  .tracks li { display: flex; align-items: center; gap: 0.875rem; padding: 0.6875rem 1rem; border-bottom: 1px solid #2a2b35; scroll-margin-block: 6rem; }
  .tracks li:last-child { border-bottom: 0; }
  .tracks li.today { background: #1f2a8f; }
  .tracks li:target { outline: 3px solid var(--c-aura); outline-offset: -3px; background: #1f2a8f; }
  .n { flex: none; width: 1.75rem; font: 400 1.375rem var(--font-lcd); color: var(--c-lcd-1); }
  .title { flex: 1; min-width: 0; font-weight: 700; overflow-wrap: anywhere; }
  .today-chip { display: none; flex: none; font-size: 0.9375rem; padding-block: 0; }
  .today .today-chip { display: inline-block; }
  .lyrics { flex: none; font-size: var(--fs-small); color: var(--c-flash); }
  .dur { flex: none; min-width: 2.75rem; text-align: end; font: 400 1.25rem var(--font-lcd); color: #9a9cab; }
  .note { font-size: var(--fs-small); color: var(--muted); }

  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 0.75rem; }
  .pager .btn { justify-self: start; padding-block: 0.5rem; text-align: start; }
  .pager .next { grid-column: 2; justify-self: end; text-align: end; }

  @media (max-width: 52rem) {
    .layout { grid-template: 'head' 'side' 'main' / minmax(0, 1fr); }
    .case { max-width: 22rem; }
  }
</style>
