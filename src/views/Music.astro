---
// /music/ — The Shelf (08-spec-music, B2-Music board). One era shelf at a time behind tabs; each release is a CD in its
// jewel case that slides out on hover or focus, turns to show the cover and lets the disc peek out.
// Without JS: every era shelf shows, stacked, and every link works; tabs, the Show select and Surprise me stay hidden.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Cassette from '../components/Cassette.astro';
import { localePath, t, type Locale } from '../i18n';
import { formatDate } from '../lib/dates';
import { discography, mixtapes, showGroup, surprisePool, type ShelfRelease } from '../lib/music';
import type { ReleaseType } from '../lib/musicbrainz';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const releases = await discography();
// every era groups the shelf; only a draft's intro text stays out of production
const eras = (await getCollection('eras')).sort((a, b) => a.data.order - b.data.order);
const shelves = await Promise.all(
  eras
    .map((era) => ({
      era,
      own: releases.filter((r) => r.era === era.id && r.type !== 'guest'),
      guests: releases.filter((r) => r.era === era.id && r.type === 'guest'),
    }))
    .filter((s) => s.own.length + s.guests.length > 0)
    .map(async (s) => ({ ...s, Intro: !s.era.data.draft || process.env.VERCEL_ENV !== 'production' ? (await render(s.era)).Content : undefined })),
);
const current = shelves.at(-1)!.era.id; // the newest era opens first
const tapes = await mixtapes();
const pool = await surprisePool();
const filters = ['all', 'albums', 'eps', 'singles', 'collabs'] as const;
const code: Record<ReleaseType, string> = { album: 'LP', ep: 'EP', single: 'SG', collab: 'CO', remix: 'RX', guest: 'FT' };
const short = (years: string) => years.replace(/\b(19|20)(\d\d)\b/g, '’$2');
const href = (r: ShelfRelease) => localePath(`/music/${r.slug}/`, locale);
const meta = (r: ShelfRelease) =>
  [
    t(locale, `type.${r.type}`),
    formatDate(r.date, locale),
    r.type === 'guest' ? r.artistCredit : r.tracks.length === 1 ? t(locale, 'release.track') : t(locale, 'release.tracks', { n: String(r.tracks.length) }),
  ].join(' · ');
/** The shelf LCD has only ASCII glyphs (VT323 subset). */
const lcd = (text: string) => text.toUpperCase().replace(/[’‘]/g, "'").normalize('NFKD').replace(/[^\x20-\x7e]/g, '');
---

<Base title={t(locale, 'music.title')} description={t(locale, 'music.description')}>
  <div class="music">
    <header class="music-head">
      <div>
        <p class="kicker">{t(locale, 'music.kicker')}</p>
        <h1>{t(locale, 'music.heading')}</h1>
      </div>
      <div class="tools" hidden data-tools>
        <button type="button" class="btn btn-primary" data-surprise data-pool={JSON.stringify(pool)} data-base={localePath('/music/', locale)}>
          <span aria-hidden="true">⚄</span> {t(locale, 'music.surprise')}
        </button>
        <label class="show">
          {t(locale, 'music.show')}
          <select data-filter>
            {filters.map((f) => <option value={f}>{t(locale, `music.show.${f}`)}</option>)}
          </select>
        </label>
        <span class="visually-hidden" role="status" data-count data-label={t(locale, 'music.count')}></span>
      </div>
    </header>

    <section class="cabinet-wrap" aria-label={t(locale, 'music.heading')}>
      <div class="tabs" role="tablist" aria-label={t(locale, 'music.eras')} hidden data-tabs>
        {
          shelves.map(({ era }) => (
            <button type="button" role="tab" class="tab" id={`tab-${era.id}`} data-era={era.id} aria-controls={`era-${era.id}`}
              aria-selected={era.id === current ? 'true' : 'false'} tabindex={era.id === current ? 0 : -1}>
              {era.data.title} <span class="tab-years">{short(era.data.years)}</span>
            </button>
          ))
        }
      </div>
      <div class="cabinet" data-era={current} data-cabinet>
        {
          shelves.map(({ era, own, guests, Intro }) => (
            <section class="shelf" id={`era-${era.id}`} data-era={era.id} aria-labelledby={`era-${era.id}-title`} data-shelf>
              <div class="shelf-head">
                <h2 id={`era-${era.id}-title`}>
                  {era.data.title} <span class="years">{era.data.years}</span>
                </h2>
                {Intro && <div class="intro"><Intro /></div>}
                <p class="hint">{t(locale, 'music.shelfHint')}</p>
                <p class="hint-touch">{t(locale, 'music.swipeHint')}</p>
                <div class="deck" aria-hidden="true">
                  <span class="deck-top"><span>&#9654; {lcd(era.data.title)}</span><span>{own.length + guests.length} CD</span></span>
                  <span class="deck-line" data-deck>{lcd(t(locale, 'music.pick'))}</span>
                </div>
              </div>
              <div class="rack">
                {[own, guests].map(
                  (list, g) =>
                    list.length > 0 && (
                      <div class:list={['group', { guests: g === 1 }]} data-group>
                        {g === 1 && <p class="guests-label">{t(locale, 'music.featuring')}</p>}
                        <ul class="cds" aria-label={g === 1 ? t(locale, 'music.featuring') : undefined}>
                          {list.map((r) => (
                            <li class:list={['cd', `cd-${r.type}`]} data-show={showGroup[r.type]}>
                              <a href={href(r)} data-lcd={`${code[r.type]} ${lcd(r.title)} '${r.date.slice(2, 4)}`}>
                                <span class:list={['spine', `spine-${r.spine}`]} aria-hidden="true">
                                  <span class="spine-code">{code[r.type]}</span>
                                  <span class="spine-title">{r.title}</span>
                                  <span class="spine-year">’{r.date.slice(2, 4)}</span>
                                </span>
                                <span class="disc" aria-hidden="true" />
                                <span class="front">
                                  <Cover image={r.image} title={r.title} alt="" widths={[112, 384]} sizes="(min-width: 64rem) 192px, 56px" class="cd-cover" />
                                  <span class="info">
                                    <b>{r.title}</b>
                                    <span class="meta">{meta(r)}</span>
                                  </span>
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ),
                )}
              </div>
              <div class="plank" aria-hidden="true" />
            </section>
          ))
        }
      </div>
    </section>

    {
      tapes.length > 0 && (
        <section class="tapes" aria-labelledby="tapes-title">
          <div class="tapes-head">
            <h2 id="tapes-title">{t(locale, 'music.mixtapes')}</h2>
            <p>{t(locale, 'music.mixtapesNote')}</p>
          </div>
          <ul>
            {tapes.map((m, i) => (
              <li>
                <Cassette tape={m} variant={(i % 4) + 1} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="data-note">{t(locale, 'music.dataNote')}</p>
  </div>
</Base>

<script>
  import '../scripts/surprise';

  const root = document.documentElement;
  const cabinet = document.querySelector<HTMLElement>('[data-cabinet]')!;
  const tablist = document.querySelector<HTMLElement>('[data-tabs]')!;
  const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-shelf]')];
  const select = document.querySelector<HTMLSelectElement>('[data-filter]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;

  // Tabs (WAI-ARIA tabs pattern): one era shelf at a time, arrow keys move between eras.
  for (const panel of panels) {
    panel.setAttribute('role', 'tabpanel');
    panel.setAttribute('aria-labelledby', `tab-${panel.dataset.era}`);
  }
  // remember = put the era in the URL; not on load, or the browser would scroll to it
  const open = (tab: HTMLButtonElement, focus = false, remember = true) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    cabinet.dataset.era = tab.dataset.era;
    tablist.scrollLeft = tab.offsetLeft - tablist.offsetLeft - 16; // phones: keep the open tab in sight
    if (focus) tab.focus();
    if (remember) history.replaceState(null, '', `${location.pathname}${location.search}#era-${tab.dataset.era}`);
  };
  const visible = () => tabs.filter((t) => !t.hidden);
  const wrap = cabinet.parentElement!;
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  // phones: the era bar sticks to the top; after a switch, start the new list from its first CD
  const pick = (tab: HTMLButtonElement) => {
    open(tab);
    if (wrap.getBoundingClientRect().top < 0) wrap.scrollIntoView({ block: 'start', behavior: still.matches || root.hasAttribute('data-calm') ? 'auto' : 'smooth' });
  };
  // phones: swipe the list sideways for the next or previous era
  let x0 = 0;
  let y0 = 0;
  cabinet.addEventListener('touchstart', (e) => ({ clientX: x0, clientY: y0 } = e.touches[0]!), { passive: true });
  cabinet.addEventListener('touchend', (e) => {
    const { clientX, clientY } = e.changedTouches[0]!;
    const dx = clientX - x0;
    if (Math.abs(dx) < 60 || Math.abs(clientY - y0) > Math.abs(dx) / 2) return;
    const list = visible();
    const next = list[list.findIndex((t) => t.getAttribute('aria-selected') === 'true') + (dx < 0 ? 1 : -1)];
    if (next) pick(next);
  });
  for (const tab of tabs) {
    tab.addEventListener('click', () => pick(tab));
    tab.addEventListener('keydown', (e) => {
      const list = visible();
      const i = list.indexOf(tab);
      const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: list.length - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      open(list[(to + list.length) % list.length]!, true);
    });
  }

  // Show select: hides the other kinds, and the eras (tabs) left empty; keeps the choice in ?show=.
  const show = (kind: string, announce = true) => {
    let n = 0;
    for (const cd of document.querySelectorAll<HTMLElement>('.cd')) {
      cd.hidden = kind !== 'all' && cd.dataset.show !== kind;
      if (!cd.hidden) n++;
    }
    for (const group of document.querySelectorAll<HTMLElement>('[data-group]')) group.hidden = !group.querySelector('.cd:not([hidden])');
    for (const tab of tabs) tab.hidden = !document.getElementById(tab.getAttribute('aria-controls')!)!.querySelector('.cd:not([hidden])');
    const selected = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
    if (!selected || selected.hidden) open(visible().at(-1)!, false, announce);
    if (announce) count.textContent = count.dataset.label!.replace('{n}', String(n));
    const url = new URL(location.href);
    if (kind === 'all') url.searchParams.delete('show');
    else url.searchParams.set('show', kind);
    history.replaceState(null, '', url);
  };
  select.addEventListener('change', () => show(select.value));

  const asked = new URLSearchParams(location.search).get('show') ?? 'all';
  select.value = [...select.options].some((o) => o.value === asked) ? asked : 'all';
  const fromHash = tabs.find((t) => `#era-${t.dataset.era}` === location.hash);
  open(fromHash ?? tabs.find((t) => t.getAttribute('aria-selected') === 'true')!, false, false);
  show(select.value, false);
  root.dataset.shelfTabs = '';
  tablist.hidden = false;
  const selectedTab = tabs.find((t) => t.getAttribute('aria-selected') === 'true')!;
  tablist.scrollLeft = selectedTab.offsetLeft - tablist.offsetLeft - 16;

  // The shelf LCD names the CD being pulled out.
  for (const deck of document.querySelectorAll<HTMLElement>('[data-deck]')) {
    const idle = deck.textContent!;
    const shelf = deck.closest('[data-shelf]')!;
    const say = (e: Event) => {
      const a = (e.target as Element).closest<HTMLElement>('[data-lcd]');
      deck.textContent = a && (e.type === 'pointerover' || e.type === 'focusin') ? a.dataset.lcd! : idle;
    };
    for (const type of ['pointerover', 'pointerout', 'focusin', 'focusout']) shelf.addEventListener(type, say);
  }

  document.querySelector<HTMLElement>('[data-tools]')!.hidden = false;
</script>

<style>
  .music { width: var(--column); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; padding-block: 0.5rem 1rem; }

  .music-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem 1.25rem; }
  .kicker { margin-bottom: 0.375rem; font-size: var(--fs-small); font-weight: 700; color: var(--era-accent-text); }
  h1 { font-size: clamp(1.875rem, 0.25rem + 7.5vw, 5rem); font-stretch: 150%; letter-spacing: -0.02em; line-height: 0.92; overflow-wrap: break-word; }
  .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .show { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .show select {
    min-height: 48px;
    padding: 0 2.25rem 0 0.75rem;
    font: 400 1rem var(--font-body);
    color: var(--ink);
    background:
      linear-gradient(45deg, transparent 50%, var(--ink) 50%) calc(100% - 1.125rem) 50% / 6px 6px no-repeat,
      linear-gradient(-45deg, transparent 50%, var(--ink) 50%) calc(100% - 0.75rem) 50% / 6px 6px no-repeat,
      var(--surface);
    border: var(--border) solid var(--line);
    box-shadow: var(--shadow-sm);
    appearance: none;
    cursor: pointer;
  }

  /* ---------- tabs: index cards clipped to the top of the cabinet ---------- */
  .cabinet-wrap { display: grid; }
  .tabs { display: flex; gap: 0.25rem; padding-inline: 0.75rem; overflow-x: auto; scrollbar-width: none; }
  .tab {
    flex: none;
    min-height: 44px;
    padding: 0 1rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 70%, var(--bg));
    border: var(--border) solid var(--line);
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
    cursor: pointer;
    translate: 0 4px;
    transition: translate 120ms ease, background-color 120ms ease;
  }
  .tab:hover { translate: 0 1px; }
  .tab[aria-selected='true'] { translate: 0 0; background: var(--era-accent); color: var(--on-era-accent); border-color: var(--c-ink); }
  .tab-years { font: 400 1.125rem var(--font-lcd); }
  .tab:focus-visible { outline-offset: -5px; }

  /* ---------- the cabinet: an object on the board, dark wood-and-ink in every theme ---------- */
  .cabinet {
    position: relative;
    min-width: 0;
    display: grid;
    gap: 2rem;
    padding: 1.5rem 1.75rem 0;
    background:
      radial-gradient(color-mix(in srgb, var(--era-accent) 30%, transparent) 1px, transparent 1.6px) 0 0 / 8px 8px,
      linear-gradient(180deg, var(--c-remote-hi), var(--c-remote-lo));
    color: var(--c-flash);
    border: var(--border) solid var(--c-ink);
    box-shadow: 8px 8px 0 var(--era-accent);
    transition: box-shadow 200ms ease;
  }
  .shelf-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 2rem; row-gap: 0.375rem; margin-bottom: 0.5rem; }
  .shelf-head > :not(.deck) { grid-column: 1; max-width: 46rem; }
  .shelf h2 { font-size: var(--fs-h3); font-stretch: 125%; }
  .years { font: 400 1.25rem var(--font-lcd); color: var(--c-lcd-1); margin-inline-start: 0.375rem; }
  .intro, .hint { font-size: 0.875rem; color: var(--c-remote-label); }
  .intro :global(p) { margin: 0; }
  /* with tabs, the tab already names the era */
  :global(html[data-shelf-tabs]) .shelf h2 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .rack { display: flex; align-items: flex-end; gap: 0.375rem; min-height: 18rem; padding-top: 1.25rem; }
  .group, .cds { display: flex; align-items: flex-end; gap: 0.3125rem; }
  .cds { padding: 0; list-style: none; }
  .guests { margin-inline-start: 0.75rem; padding-inline-start: 0.75rem; border-inline-start: 2px dashed var(--c-remote-label); }
  .guests-label { writing-mode: vertical-rl; rotate: 180deg; align-self: stretch; text-align: end; font-size: var(--fs-small); color: var(--c-remote-label); }
  /* the shelf LCD: the remote's display, standing at the end of the shelf */
  .deck {
    display: grid;
    gap: 0.25rem;
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: start;
    width: 14rem;
    margin: 0.25rem 0.25rem 0 0;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-lcd);
    line-height: 1;
    color: var(--c-lcd-ink);
    background: linear-gradient(180deg, var(--c-lcd-1), var(--c-lcd-2));
    border: 3px solid var(--c-remote-edge);
    border-radius: 8px;
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.45), 0 0 0 4px var(--c-remote-mid), 4px 6px 0 6px rgb(0 0 0 / 0.35);
  }
  .deck-top { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.9375rem; white-space: nowrap; }
  .deck-line { font-size: 1.375rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* the plank: wood grain, a lit front edge and the shadow the cases cast */
  .plank {
    position: relative;
    height: 1.5rem;
    margin-inline: -1.75rem;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.28) 0 2px, transparent 2px),
      repeating-linear-gradient(92deg, rgb(70 38 16 / 0.18) 0 3px, transparent 3px 11px, rgb(255 230 190 / 0.1) 11px 13px, transparent 13px 29px),
      linear-gradient(#b98b5f, #7b4f2e);
    border-top: var(--border) solid var(--c-ink);
    box-shadow: inset 0 -5px 0 rgb(0 0 0 / 0.22);
  }
  .plank::before { content: ''; position: absolute; inset: -0.875rem 0 auto; height: 0.75rem; background: linear-gradient(transparent, rgb(0 0 0 / 0.35)); pointer-events: none; }

  /* ---------- a CD in its jewel case ---------- */
  .cd { --w: 2.25rem; position: relative; }
  .cd-ep { --w: 2.625rem; }
  .cd-album { --w: 3.125rem; }
  .cd a {
    position: relative;
    display: block;
    width: var(--w);
    height: 16rem;
    color: var(--c-ink);
    text-decoration: none;
    transform-origin: 50% 100%;
    transition: width 320ms cubic-bezier(0.2, 0.8, 0.2, 1), translate 320ms cubic-bezier(0.2, 0.8, 0.2, 1), rotate 320ms ease;
  }
  .spine {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 0 0.5rem;
    overflow: hidden;
    border: var(--border) solid var(--c-ink);
    box-shadow: 3px 0 0 color-mix(in srgb, var(--c-ink) 30%, transparent);
    /* plastic: a lit left edge, hinge ridges top and bottom, a soft shadow on the right */
    background-image:
      linear-gradient(90deg, rgb(255 255 255 / 0.6) 0 3px, rgb(255 255 255 / 0.12) 3px 7px, transparent 7px calc(100% - 5px), rgb(0 0 0 / 0.22) calc(100% - 5px)),
      linear-gradient(180deg, transparent 5px, rgb(0 0 0 / 0.25) 5px 6px, transparent 6px calc(100% - 6px), rgb(0 0 0 / 0.25) calc(100% - 6px) calc(100% - 5px), transparent calc(100% - 5px));
    transition: opacity 140ms ease;
  }
  .spine-code {
    flex: none;
    padding: 0.125rem 0.1875rem 0;
    font: 400 0.9375rem / 1 var(--font-lcd);
    color: var(--c-lcd-1);
    background: var(--c-ink);
    border-radius: 2px;
  }
  .spine-title {
    flex: 1;
    min-height: 0;
    writing-mode: vertical-rl;
    text-orientation: sideways; /* every glyph turned like the letters, so ’ stays an apostrophe */
    rotate: 180deg;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
    font: 800 0.8125rem / 1 var(--font-display);
    font-stretch: 80%;
    text-transform: uppercase;
  }
  .cd-album .spine-title { font-size: 0.9375rem; font-stretch: 95%; }
  .spine-year { flex: none; font: 400 1rem / 1 var(--font-lcd); }
  .spine-flash { background-color: #ffffff; }
  .spine-night { background-color: #3a3c48; color: #ffffff; }
  .spine-plush { background-color: #ff8fc7; }
  .spine-aura { background-color: #ff4a1c; }
  .spine-peri { background-color: #9aa6ff; }
  .spine-lemon { background-color: #fff36b; }
  .spine-strobe { background-color: #2335f0; color: #ffffff; }
  .spine-grass { background-color: #3f9a3a; }

  /* the disc: silver with a rainbow sheen, hidden inside the case until it is pulled out */
  .disc {
    position: absolute;
    top: 0.75rem;
    left: 0.5rem;
    width: 11rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: var(--border) solid var(--c-ink);
    background:
      radial-gradient(circle, var(--c-remote-lo) 0 8%, #e9eaf0 8.5% 15%, rgb(0 0 0 / 0.25) 15.5% 16.5%, transparent 17%),
      conic-gradient(from 20deg, #d6d8e2, #ffffff, #c8d2ff, #ffd3ec, #f4f9d6, #d6d8e2, #ffffff, #bfe7ff, #ffd3ec, #d6d8e2);
    opacity: 0;
    scale: 0.4;
    pointer-events: none;
    transition: translate 420ms cubic-bezier(0.2, 0.8, 0.2, 1) 80ms, opacity 120ms ease, scale 0ms 420ms;
  }
  .front {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem 0.5rem 0.5rem;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.16), transparent 40%), var(--c-remote-lo);
    color: var(--c-flash);
    border: var(--border) solid var(--c-ink);
    opacity: 0;
    pointer-events: none;
  }
  /* the case hinge, on the right of the front */
  .front::after { content: ''; position: absolute; inset: 0 0 0 auto; width: 0.375rem; background: var(--c-ink); }
  .cd :global(.cd-cover) { display: none; border: 1px solid var(--c-ink); }
  /* closed: the name stays for screen readers only */
  .info { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .info b { font: 900 1rem / 1 var(--font-display); font-stretch: 125%; overflow-wrap: anywhere; }
  .meta { font-size: var(--fs-small); line-height: 1.25; }

  /* pulled out: the case slides up and turns, the cover swings round, the disc peeks out of the side */
  .cd a:is(:hover, :focus-visible) { z-index: 2; width: 12.5rem; translate: 0 -1.25rem; rotate: -2deg; }
